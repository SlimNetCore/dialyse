# Copier en ".env" à la racine du projet : cp env.prod.example .env
# (Le fichier .env est ignoré par git : ne jamais le committer.)

# --- Base PostgreSQL ---
POSTGRES_DB=hemodialyse
POSTGRES_USER=hemo_user
POSTGRES_PASSWORD=CHANGER_MOI_mot_de_passe_fort

# --- Sécurité backend ---
# Générer avec : openssl rand -base64 48
JWT_SECRET=CHANGER_MOI_secret_jwt_d_au_moins_32_caracteres
# Jeton exigé pour créer le compte propriétaire (recommandé sur Internet)
SETUP_TOKEN=

# --- Exposition (HTTPS via Caddy, certificat Let's Encrypt automatique) ---
# Nom de domaine servi (les enregistrements DNS A de DOMAIN et www.DOMAIN doivent pointer vers la VM)
DOMAIN=plateforme-hemodialyse.online
# Adresse e-mail pour Let's Encrypt (alertes d'expiration)
ACME_EMAIL=s_bourahla@esi.dz
# Cookies d'authentification : Secure obligatoire en HTTPS
AUTH_COOKIE_SECURE=true
# URL publique du site (front et API partagent la même origine ; CORS utile seulement en cas de domaine séparé)
CORS_ORIGINS=https://plateforme-hemodialyse.online

# --- Options ---
STOCK_DEMO_DATA=false
# VM 1 Go (AMD micro) : réduire ; VM Ampere : monter à 75
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/./urandom

# --- Réglage PostgreSQL (valeurs par défaut du compose : VM 1 Go) ---
# VM Ampere 6 Go : PG_SHARED_BUFFERS=1GB  PG_EFFECTIVE_CACHE_SIZE=3GB  PG_WORK_MEM=16MB  PG_MAINTENANCE_WORK_MEM=256MB
# (laisser la RAM restante au backend : JAVA_OPTS ci-dessus)
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE_SIZE=768MB
# PG_WORK_MEM=8MB
# PG_MAINTENANCE_WORK_MEM=64MB

# --- Repli d'urgence ---
# En production Hibernate est en "validate" (le schéma n'évolue que par Flyway). Si un démarrage échoue sur une
# validation de schéma, HIBERNATE_DDL_AUTO=none permet de redémarrer le temps de corriger la migration manquante.
# HIBERNATE_DDL_AUTO=validate

# --- Licences (optionnel mais recommandé en production) ---
APP_LICENSE_PUBLIC_KEY=
APP_LICENSE_PRIVATE_KEY=

