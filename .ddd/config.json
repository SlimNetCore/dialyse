{
  "mode": "legacy",
  "language": "java, typescript",
  "framework": "Spring Boot 4 (Java 21), Angular 22",
  "testFramework": "JUnit 5 + Mockito, Vitest + Playwright",
  "docsLanguage": "fr",
  "legacyPaths": [
    "backend/**/src/main/java/**"
  ],
  "newCodeRoot": "backend/contexts",
