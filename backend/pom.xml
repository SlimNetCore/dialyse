<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.8</version>
        <relativePath/>
	</parent>
	<groupId>com.hemodialyse</groupId>
    <artifactId>backend-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>backend-parent</name>
	<properties>
        <!-- Fuseau unique du serveur : UTC (BackendApplication, Hibernate, Jackson) ; les tests tournent dans le meme fuseau -->
        <argLine>-Duser.timezone=UTC</argLine>
		<java.version>21</java.version>
        <timefold-solver.version>2.7.0</timefold-solver.version>
        <org-springframework-security.spring-security-core.version>7.0.5</org-springframework-security.spring-security-core.version>
        <org-springframework-security.spring-security-config.version>7.0.5</org-springframework-security.spring-security-config.version>
        <org-springframework-security.spring-security-web.version>7.0.5</org-springframework-security.spring-security-web.version>
        <org-apache-tomcat-embed.tomcat-embed-websocket.version>11.0.22</org-apache-tomcat-embed.tomcat-embed-websocket.version>
	</properties>
    <modules>
        <module>contexts/shared-kernel</module>
        <module>contexts/documents-api</module>
        <module>contexts/gmao</module>
        <module>contexts/comptabilite</module>
        <module>contexts/facturation</module>
        <module>contexts/absences-patients</module>
        <module>contexts/stock</module>
        <module>contexts/planification</module>
        <module>contexts/organisation</module>
        <module>contexts/patient-couverture</module>
        <module>contexts/dossier-medical</module>
        <module>contexts/seance</module>
        <module>contexts/pilotage-direction</module>
        <module>contexts/notifications</module>
        <module>contexts/documents</module>
        <module>demo-data</module>
        <module>platform</module>
    </modules>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ai.timefold.solver</groupId>
                <artifactId>timefold-solver-core</artifactId>
                <version>${timefold-solver.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.security</groupId>
                <artifactId>spring-security-core</artifactId>
                <version>${org-springframework-security.spring-security-core.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.security</groupId>
                <artifactId>spring-security-config</artifactId>
                <version>${org-springframework-security.spring-security-config.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.security</groupId>
                <artifactId>spring-security-web</artifactId>
                <version>${org-springframework-security.spring-security-web.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>${org-apache-tomcat-embed.tomcat-embed-websocket.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
