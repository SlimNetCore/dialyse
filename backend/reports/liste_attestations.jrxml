<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="liste_attestations" pageWidth="842" pageHeight="595" orientation="Landscape"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" columnWidth="802">
    <parameter name="CENTER_ID" class="java.lang.String"/>
    <queryString><![CDATA[
      SELECT a.id, p.code_patient, p.nom, p.prenom, p.numero_assurance,
             a.date_debut, a.date_fin
      FROM attestation_droit a
      JOIN patients p ON p.id = a.patient_id AND p.center_id = a.center_id
      WHERE a.center_id = CAST($P{CENTER_ID} AS UUID)
      ORDER BY a.date_fin DESC
    ]]></queryString>

    <field name="CODE_PATIENT" class="java.lang.String"/>
    <field name="NOM" class="java.lang.String"/>
    <field name="PRENOM" class="java.lang.String"/>
    <field name="NUMERO_ASSURANCE" class="java.lang.String"/>
    <field name="DATE_DEBUT" class="java.sql.Date"/>
    <field name="DATE_FIN" class="java.sql.Date"/>

    <title><band height="40"><staticText><reportElement x="0" y="8" width="802" height="24"/><textElement textAlignment="Center"><font size="14" isBold="true"/></textElement><text><![CDATA[LISTE DES OUVERTURES DE DROIT]]></text></staticText></band></title>
    <columnHeader><band height="20">
      <staticText><reportElement x="0" y="0" width="100" height="18" backcolor="#1B5E20" mode="Opaque" forecolor="#FFFFFF"/><textElement textAlignment="Center"><font size="8" isBold="true"/></textElement><text><![CDATA[Code]]></text></staticText>
      <staticText><reportElement x="100" y="0" width="140" height="18" backcolor="#1B5E20" mode="Opaque" forecolor="#FFFFFF"/><textElement textAlignment="Center"><font size="8" isBold="true"/></textElement><text><![CDATA[Nom]]></text></staticText>
      <staticText><reportElement x="240" y="0" width="140" height="18" backcolor="#1B5E20" mode="Opaque" forecolor="#FFFFFF"/><textElement textAlignment="Center"><font size="8" isBold="true"/></textElement><text><![CDATA[Prénom]]></text></staticText>
      <staticText><reportElement x="380" y="0" width="170" height="18" backcolor="#1B5E20" mode="Opaque" forecolor="#FFFFFF"/><textElement textAlignment="Center"><font size="8" isBold="true"/></textElement><text><![CDATA[N° Assurance]]></text></staticText>
      <staticText><reportElement x="550" y="0" width="126" height="18" backcolor="#1B5E20" mode="Opaque" forecolor="#FFFFFF"/><textElement textAlignment="Center"><font size="8" isBold="true"/></textElement><text><![CDATA[Date début]]></text></staticText>
      <staticText><reportElement x="676" y="0" width="126" height="18" backcolor="#1B5E20" mode="Opaque" forecolor="#FFFFFF"/><textElement textAlignment="Center"><font size="8" isBold="true"/></textElement><text><![CDATA[Date fin]]></text></staticText>
    </band></columnHeader>
    <detail><band height="16">
      <textField><reportElement x="0" y="0" width="100" height="14"/><textElement textAlignment="Center"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{CODE_PATIENT}]]></textFieldExpression></textField>
      <textField><reportElement x="100" y="0" width="140" height="14"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$F{NOM}]]></textFieldExpression></textField>
      <textField><reportElement x="240" y="0" width="140" height="14"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$F{PRENOM}]]></textFieldExpression></textField>
      <textField><reportElement x="380" y="0" width="170" height="14"/><textElement textAlignment="Center"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{NUMERO_ASSURANCE}]]></textFieldExpression></textField>
      <textField><reportElement x="550" y="0" width="126" height="14"/><textElement textAlignment="Center"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{DATE_DEBUT}]]></textFieldExpression></textField>
      <textField><reportElement x="676" y="0" width="126" height="14"/><textElement textAlignment="Center"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{DATE_FIN}]]></textFieldExpression></textField>
    </band></detail>
</jasperReport>

