<?xml version="1.0" encoding="UTF-8"?>
<!--
  Planning de présence des infirmiers d'une semaine (modèle de document PLANNING_PRESENCE_INFIRMIERS, personnalisable par centre).
  DOC5e (ADR 0197) : le gabarit n'embarque plus de requête ; la Planification fournit les lignes dans le paramètre LIGNES
  (champs DATE_JOUR, SALLE, CRENEAU_CODE, CRENEAU, INFIRMIER, STATUT : une par infirmier prévu, absent ou remplaçant, dans l'ordre
  jour, code du créneau, salle, situation, infirmier). Les paramètres CENTER_ID et DATE_0 à DATE_6 restent déclarés (modèles
  personnalisés déjà stockés).
  Contraintes « modèle personnalisable » (JrxmlSecurityValidator) : aucune requête, expressions simples, police standard.
-->
<jasperReport xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="planning_presence_infirmiers" pageWidth="842" pageHeight="595" orientation="Landscape"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" columnWidth="802">
    <parameter name="CENTER_ID" class="java.lang.String"/>
    <parameter name="SEMAINE_LABEL" class="java.lang.String"/>
    <parameter name="DATE_0" class="java.sql.Date"/>
    <parameter name="DATE_1" class="java.sql.Date"/>
    <parameter name="DATE_2" class="java.sql.Date"/>
    <parameter name="DATE_3" class="java.sql.Date"/>
    <parameter name="DATE_4" class="java.sql.Date"/>
    <parameter name="DATE_5" class="java.sql.Date"/>
    <parameter name="DATE_6" class="java.sql.Date"/>
    <parameter name="SOCIETE_NOM" class="java.lang.String"/>
    <parameter name="SOCIETE_ADRESSE" class="java.lang.String"/>
    <parameter name="SOCIETE_TELEPHONE" class="java.lang.String"/>
    <parameter name="SOCIETE_EMAIL" class="java.lang.String"/>
    <parameter name="SOCIETE_SITE_WEB" class="java.lang.String"/>
    <parameter name="SOCIETE_CONTACT" class="java.lang.String"/>
    <parameter name="SOCIETE_LEGAL" class="java.lang.String"/>
    <parameter name="SOCIETE_PIED_PAGE" class="java.lang.String"/>
    <parameter name="SOCIETE_LOGO" class="java.io.InputStream"/>
    <parameter name="CENTRE_NOM" class="java.lang.String"/>
    <parameter name="CENTRE_ADRESSE" class="java.lang.String"/>
    <parameter name="CENTRE_TELEPHONE" class="java.lang.String"/>
    <parameter name="CENTRE_EMAIL" class="java.lang.String"/>
    <parameter name="CENTRE_SITE_WEB" class="java.lang.String"/>
    <parameter name="CENTRE_CONTACT" class="java.lang.String"/>
    <parameter name="CENTRE_LIGNE" class="java.lang.String"/>

    <field name="DATE_JOUR" class="java.sql.Date"/>
    <field name="SALLE" class="java.lang.String"/>
    <field name="CRENEAU_CODE" class="java.lang.String"/>
    <field name="CRENEAU" class="java.lang.String"/>
    <field name="INFIRMIER" class="java.lang.String"/>
    <field name="STATUT" class="java.lang.String"/>

    <group name="JOUR">
        <groupExpression><![CDATA[$F{DATE_JOUR}]]></groupExpression>
        <groupHeader>
            <band height="22">
                <textField pattern="EEEE dd/MM/yyyy">
                    <reportElement x="0" y="3" width="802" height="17" backcolor="#E8F5E9" mode="Opaque"/>
                    <textElement textAlignment="Left">
                        <font size="9" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{DATE_JOUR}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
    </group>

    <title>
        <band height="106">
            <image scaleImage="RetainShape" hAlign="Left" vAlign="Top" onErrorType="Blank">
                <reportElement x="0" y="0" width="70" height="56">
                    <printWhenExpression><![CDATA[$P{SOCIETE_LOGO} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{SOCIETE_LOGO}]]></imageExpression>
            </image>
            <textField isBlankWhenNull="true">
                <reportElement x="78" y="0" width="396" height="16"/>
                <textElement textAlignment="Left">
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SOCIETE_NOM}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="78" y="17" width="396" height="26"/>
                <textElement textAlignment="Left">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SOCIETE_CONTACT}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="78" y="44" width="396" height="12"/>
                <textElement textAlignment="Left">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SOCIETE_LEGAL}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="482" y="0" width="320" height="14"/>
                <textElement textAlignment="Right">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CENTRE_NOM}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="482" y="15" width="320" height="14"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CENTRE_ADRESSE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="482" y="30" width="320" height="26"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CENTRE_CONTACT}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="60" width="802" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="68" width="802" height="22"/>
                <textElement textAlignment="Center">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[PLANNING DE PRÉSENCE DES INFIRMIERS]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="90" width="802" height="14"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SEMAINE_LABEL}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="140" height="18" backcolor="#1B5E20" mode="Opaque"
                               forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Créneau]]></text>
            </staticText>
            <staticText>
                <reportElement x="140" y="0" width="180" height="18" backcolor="#1B5E20" mode="Opaque"
                               forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Salle]]></text>
            </staticText>
            <staticText>
                <reportElement x="320" y="0" width="300" height="18" backcolor="#1B5E20" mode="Opaque"
                               forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Infirmier]]></text>
            </staticText>
            <staticText>
                <reportElement x="620" y="0" width="182" height="18" backcolor="#1B5E20" mode="Opaque"
                               forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Situation]]></text>
            </staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="16">
            <textField>
                <reportElement x="0" y="0" width="140" height="14"/>
                <textElement textAlignment="Center">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{CRENEAU}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="140" y="0" width="180" height="14"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{SALLE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="320" y="0" width="300" height="14"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{INFIRMIER}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="620" y="0" width="182" height="14"/>
                <textElement textAlignment="Center">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{STATUT}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="28">
            <line>
                <reportElement x="0" y="0" width="802" height="1"/>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="3" width="802" height="11"/>
                <textElement textAlignment="Center">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CENTRE_LIGNE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="14" width="802" height="11"/>
                <textElement textAlignment="Center">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SOCIETE_PIED_PAGE}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
