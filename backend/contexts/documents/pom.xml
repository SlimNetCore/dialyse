<?xml version="1.0" encoding="UTF-8"?>
<!-- Contexte Documents (rendu des documents imprimables des centres : papier en-tete, routes d'impression ; ADR 0140, 0142).
     Reprise SUR PLACE (ADR 0024) : memes tables modele_document*, memes URL /api/v1/documents/print[/{modeleId}].
     Le moteur de rendu (Jasper) reste a la plateforme derriere le port publie MoteurDeRendu jusqu'a DOC2. -->
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.hemodialyse</groupId>
        <artifactId>backend-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>contexts-documents</artifactId>
    <name>contexts-documents</name>
    <description>Bounded context Documents (hexagonal : domain, application, infrastructure, interfaces,
        publishedlanguage, configuration)
    </description>

    <properties>
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-shared-kernel</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Langage publie d'Organisation (IdentiteImprimee, ADR 0111 ; ADR 0142 : tient lieu d'IdentiteImprimable de l'ADR 0140 D4) :
             seul point d'entree (ArchUnit), lu par l'ACL infrastructure/acl/organisation. contexts-organisation ne depend pas de ce module. -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-organisation</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Port de rendu publié (RenduDeDocument, DocumentRendu) : module pur Java, partagé avec GMAO sans cycle Maven (PL6, ADR 0145). -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-documents-api</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Moteur de rendu (DOC2, ADR 0162) : repris de la plateforme, memes versions -->
        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports</artifactId>
            <version>6.21.5</version>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Polices PDF (POL1, ADR 0208) : DejaVu Sans (Bitstream Vera / DejaVu, libre, embarquement autorise) ; l'artefact declare
             lui-meme l'extension de polices (jasperreports_extension.properties). La police par defaut est posee par jasperreports.properties. -->
        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports-fonts</artifactId>
            <version>6.21.5</version>
        </dependency>
        <!-- Lecture du PDF rendu (test POL1 : polices embarquees, texte extrait) ; meme version que celle de la plateforme -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>2.0.24</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.2.5</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
