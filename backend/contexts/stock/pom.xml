<?xml version="1.0" encoding="UTF-8"?>
<!-- Contexte Stock (ADR 0024, 0045) : refonte sur place, mêmes tables (articles, fournisseurs, emplacements…) et mêmes URLs
     (/api/v1/stock/**) que le legacy. Module consommé par platform. Slice S1 : référentiel (articles, fournisseurs,
     emplacements) et catalogue publié (CatalogueDArticles). -->
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.hemodialyse</groupId>
        <artifactId>backend-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>contexts-stock</artifactId>
    <name>contexts-stock</name>
    <description>Bounded context Stock (hexagonal : domain, application, infrastructure, interfaces, configuration)
    </description>

    <properties>
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Contrat PostgreSQL 16 reel (ITs *PostgresContractIT, actives par -Dstock.pg16.url) : verrou de ligne et delai de requete -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
            <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-shared-kernel</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- PL7 : langage publié de Documents (documents.v1, RenduDeDocument) : seul point d'entrée vers Documents (ArchUnit) -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-documents-api</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- PL7 : feuille de comptage Excel, même version que la plateforme -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>
</dependencies>

    <build>
        <plugins>
            <!-- Mutation testing du domaine et de l'application (ADR 0016) : non lié au cycle de vie.
                 Lancer : ./mvnw -pl contexts/stock org.pitest:pitest-maven:mutationCoverage -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.30.0</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.3</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>com.hemodialyse.backend.contexts.stock.domain.*</param>
                        <param>com.hemodialyse.backend.contexts.stock.application.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.hemodialyse.backend.contexts.stock.domain.*</param>
                        <param>com.hemodialyse.backend.contexts.stock.application.*</param>
                    </targetTests>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

