<?xml version="1.0" encoding="UTF-8"?>
<!-- Contexte Absences de patients (ADR 0024, 0038) : refonte sur place, même table (absence_patient) et mêmes URLs que le
     legacy. Module consommé par platform. Slice A1 : consultation (liste, semaine, synthèse, séances de rattrapage), lectures
     seules, aucun événement publié. -->
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.hemodialyse</groupId>
        <artifactId>backend-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>contexts-absences-patients</artifactId>
    <name>contexts-absences-patients</name>
    <description>Bounded context Absences de patients (hexagonal : domain, application, infrastructure, interfaces,
        configuration)
    </description>

    <properties>
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <dependencies>
        <!-- Langages publiés lus par les Absences (slice A2) : Comptabilité (ParametrageFiscal, taux de TVA) et Facturation
             (FacturationDuPatient, période facturée ; DeclarationDesAbsences, fournie via l'ACL de platform). Seuls points
             d'entrée vers ces contextes (ArchUnit). -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-comptabilite</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-facturation</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Présence des patients (slice P6) : PresenceDesPatients, l'unique calcul des patients attendus (RG-PLN-045). -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-planification</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Langage publié de Patient et couverture (PC5) : FichesDesPatients, CouvertureDesPatients (plus de SQL sur les tables du patient). -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-patient-couverture</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Langage publie de Notifications (notifications.v1), PL13d, ADR 0156 : seul point d'entree (ArchUnit). -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-notifications</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Contrat PostgreSQL 16 réel (ITs *PostgresContractIT, activés par -Dabsences.pg16.url) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
            <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-shared-kernel</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Langage publié d'Organisation (AnnuaireDesCentres, O4 lot A, ADR 0107) : seul point d'entrée (ArchUnit). -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-organisation</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
</dependencies>

    <build>
        <plugins>
            <!-- Mutation testing du domaine et de l'application (ADR 0016) : non lié au cycle de vie.
                 Lancer : ./mvnw -pl contexts/absences-patients org.pitest:pitest-maven:mutationCoverage -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.30.0</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.3</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>com.hemodialyse.backend.contexts.absencespatients.domain.*</param>
                        <param>com.hemodialyse.backend.contexts.absencespatients.application.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.hemodialyse.backend.contexts.absencespatients.domain.*</param>
                        <param>com.hemodialyse.backend.contexts.absencespatients.application.*</param>
                    </targetTests>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
