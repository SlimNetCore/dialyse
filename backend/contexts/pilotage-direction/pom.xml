<?xml version="1.0" encoding="UTF-8"?>
<!-- Contexte Pilotage direction (tableau de bord de la direction d'une societe, rapport de synthese, puis instantanes mensuels et alertes).
     Reprise SUR PLACE (ADR 0024, 0075, 0102) : memes tables, memes URL /api/v1/direction/*. Le module est revenu au reacteur au lot A (PD1 + PD4). -->
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.hemodialyse</groupId>
        <artifactId>backend-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>contexts-pilotage-direction</artifactId>
    <name>contexts-pilotage-direction</name>
    <description>Bounded context Pilotage direction (hexagonal : domain, application, infrastructure, interfaces,
        publishedlanguage, configuration)
    </description>

    <properties>
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-shared-kernel</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Langage publié d'Organisation (AnnuaireDesSocietes, O4 lot A, ADR 0107) : seul point d'entrée (ArchUnit). -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-organisation</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Langages publies des autres contextes (lecture seule) : seance.v1 (SeancesRealiseesDesCentresPubliees, SE7e), facturation
             (SyntheseFinanciereDesCentres, F5), dossier-medical.v1 (TraitementDeLAnemiePublie, DM9). Le code de PRODUCTION n'importe que
             leur paquet publishedlanguage (ArchitectureHexagonaleTest, FrontieresDesContextesTest). Aucun de ces modules ne depend du Pilotage. -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-seance</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-facturation</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-dossier-medical</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- RF3b (ADR 0127) : patientcouverture.v1 (PayeursDuCentre : la caisse d'un centre payeur). contexts-patient-couverture ne depend
             ni de ce module ni de la Seance ni de la Facturation : aucun cycle. -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-patient-couverture</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- PD6 (ADR 0106) : stock.v1 (IndicateursDuStock, S9). contexts-stock ne depend que de contexts-shared-kernel : aucun cycle. -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-stock</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
