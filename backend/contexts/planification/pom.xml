<?xml version="1.0" encoding="UTF-8"?>
<!-- Contexte Planification (ADR 0024, 0049 à 0054) : refonte sur place, mêmes tables (colonnes de place de `patients`,
     `planning_parametres`, `planification_*`, `planning_preference_patient`, `infirmier*`, `deplacement_temporaire`) et
     mêmes URLs (`/api/v1/planning/**`, `/api/v1/infirmiers/**`). Module consommé par platform. Squelette sans logique :
     les dépendances propres aux slices s'ajoutent avec elles (Timefold à P8 dans l'infrastructure seulement, ADR 0050 ;
     spring-modulith-events-api à P5 pour les événements gmao.v1 ; langage publié des Absences à P6, ADR 0053). -->
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.hemodialyse</groupId>
        <artifactId>backend-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>contexts-planification</artifactId>
    <name>contexts-planification</name>
    <description>Bounded context Planification (hexagonal : domain, application, infrastructure, interfaces,
        publishedlanguage, configuration)
    </description>

    <properties>
        <archunit.version>1.5.1</archunit.version>
        <spring-modulith.version>2.0.8</spring-modulith.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Langage publié de GMAO (P5) : GenerateursDuCentre, GenerateurDevenuIndisponible (gmao.v1). Seul point d'entrée vers
             ce contexte (ArchUnit). -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-gmao</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Solveur d'optimisation (P8, ADR 0050) : utilisé UNIQUEMENT dans infrastructure/optimisation/timefold (ArchUnit). -->
        <dependency>
            <groupId>ai.timefold.solver</groupId>
            <artifactId>timefold-solver-core</artifactId>
        </dependency>
        <!-- Registre d'événements : écouteur @ApplicationModuleListener (livraison au moins une fois, rejeu) -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-events-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Contrat PostgreSQL 16 réel (verrou du centre, ADR 0049 ; ITs *PostgresContractIT activés par -Dplanification.pg16.url) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-shared-kernel</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Langage publié de Notifications (notifications.v1 : NotifierEnDeuxTemps, DiffusionEnTempsReel, JournalDesNotifications), PL13c, ADR 0155. -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-notifications</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Langage publié d'Organisation (AnnuaireDesCentres, O4 lot A, ADR 0107) : seul point d'entrée (ArchUnit). -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-organisation</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Langage publié de Documents (documents.v1) : déclaration des types de document de la Planification, DOC4c, ADR 0166. Aucun
             cycle : documents-api ne dépend d'aucun contexte. -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-documents-api</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Mutation testing du domaine et de l'application (ADR 0016) : non lié au cycle de vie.
                 Lancer : ./mvnw -pl contexts/planification org.pitest:pitest-maven:mutationCoverage -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.30.0</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.3</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>com.hemodialyse.backend.contexts.planification.domain.*</param>
                        <param>com.hemodialyse.backend.contexts.planification.application.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.hemodialyse.backend.contexts.planification.domain.*</param>
                        <param>com.hemodialyse.backend.contexts.planification.application.*</param>
                    </targetTests>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
