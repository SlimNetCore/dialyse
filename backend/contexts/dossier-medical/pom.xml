<?xml version="1.0" encoding="UTF-8"?>
<!-- Contexte Dossier médical (dossier clinique du patient : constantes, prescriptions, séances médicales,
     résultats d'analyses, historique clinique). ADR 0007, 0065, 0072. Repris sur place : DM1 (constantes) d'abord. -->
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.hemodialyse</groupId>
        <artifactId>backend-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>contexts-dossier-medical</artifactId>
    <name>contexts-dossier-medical</name>
    <description>Bounded context Dossier médical (hexagonal : domain, application, infrastructure, interfaces,
        publishedlanguage, configuration)
    </description>

    <properties>
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-shared-kernel</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Langage publié de Documents (documents.v1) : la règle d'impression de l'ordonnance, DOC4c, ADR 0166. Aucun cycle : documents-api
             ne dépend d'aucun contexte. -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-documents-api</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Langage publié d'Organisation (AnnuaireDesCentres, O4 lot A, ADR 0107) : seul point d'entrée (ArchUnit). -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-organisation</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Langage publie de Patient et couverture : FichesDesPatients (un patient existe-t-il dans le centre ?), DM2, ADR 0081. -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-patient-couverture</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Langage publie de Notifications (notifications.v1 : NotifierEnDeuxTemps, DiffusionEnTempsReel), PL13a, ADR 0153. -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-notifications</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Langage publie de la Planification : ReaffectationEnIsolement (P5) et VerrouDesPlacesDuCentre, DM4 sérologies, ADR 0083. -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-planification</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Langage publie du Stock : CatalogueDArticles (code, libelle, conversion de dose), DM2 prescriptions, ADR 0081. -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-stock</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Langage publie de la Seance : ConstantesDesSeancesPubliees (historique des constantes), SE7d, ADR 0098. Aucun cycle : aucun
             module dont depend la Seance ne depend du Dossier medical (verifie le 2026-11-08). Le code de PRODUCTION n'importe que le
             paquet publishedlanguage (ArchitectureHexagonaleTest, FrontieresDesContextesTest). Le contrat de TEST
             HistoriqueDesConstantesJdbcContrat importe en plus l'adapter seance.infrastructure.persistence.ConstantesDesSeancesJdbc
             (il joue le vrai adapter de la Seance ; les regles ArchUnit excluent les tests). Par transitivite, les classes des
             Absences, de la Facturation et de la Comptabilite sont sur le classpath : ArchitectureHexagonaleTest les interdit. -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-seance</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Langage publie de la Comptabilite : NumerotationDesDocuments (numeros d'ordonnance, S-DDL2, ADR 0185). Deja sur le classpath par
             transitivite (contexts-seance) ; la Comptabilite ne depend pas du Dossier medical : aucun cycle. -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-comptabilite</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Export PDF du dossier de greffe (PL2, ADR 0138) : meme bibliotheque et meme version que la plateforme et la Seance. -->
        <dependency>
            <groupId>com.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
            <version>1.0.10</version>
        </dependency>
    </dependencies>

    <!-- Reprise sur place (ADR 0024, ADR 0080 ; GEL.md supprimé, HYG 2026-11-14) : le module ne porte que DM1 (constantes) ; DM2 a DM8 seront repris slice par slice. -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <!-- Mutation : domaine et cas d'usage. Lancer : bash backend/scripts/pit-dm1-module.sh -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.30.0</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.3</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>com.hemodialyse.backend.contexts.dossiermedical.domain.*</param>
                        <param>com.hemodialyse.backend.contexts.dossiermedical.application.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.hemodialyse.backend.contexts.dossiermedical.domain.*</param>
                        <param>com.hemodialyse.backend.contexts.dossiermedical.application.*</param>
                    </targetTests>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>