<?xml version="1.0" encoding="UTF-8"?>
<!-- Contexte Patient & couverture (patient administratif, assure, PEC, attestation de droits)
     ADR 0004, 0064. Squelette : aucune logique ; les dependances propres aux slices s'ajoutent avec elles. -->
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.hemodialyse</groupId>
        <artifactId>backend-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>contexts-patient-couverture</artifactId>
    <name>contexts-patient-couverture</name>
    <description>Bounded context Patient et couverture (hexagonal : domain, application, infrastructure, interfaces,
        publishedlanguage, configuration)
    </description>

    <properties>
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-shared-kernel</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <!-- Reprise sur place (ADR 0024, GEL.md) : les sources gelées d'avant la reprise (Assure, Pec, Attestation, services,
         adapters et contrôleurs aux URL et aux tables inventées) ne sont plus compilées. Elles sont à SUPPRIMER (aucun outil de
         suppression dans la session de reprise) ; PC2 à PC5 réécriront leur périmètre. -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/domain/Assure*.java</exclude>
                        <exclude>**/domain/Attestation*.java</exclude>
                        <exclude>**/domain/EtatPatient.java</exclude>
                        <exclude>**/domain/MouvementPatient*.java</exclude>
                        <exclude>**/domain/MouvementType.java</exclude>
                        <exclude>**/domain/NumeroDossier.java</exclude>
                        <exclude>**/domain/Pec*.java</exclude>
                        <exclude>**/domain/StatutPec.java</exclude>
                        <exclude>**/domain/TypeAssure.java</exclude>
                        <exclude>**/application/AssureService.java</exclude>
                        <exclude>**/application/AssureUseCases.java</exclude>
                        <exclude>**/application/AttestationService.java</exclude>
                        <exclude>**/application/AttestationUseCases.java</exclude>
                        <exclude>**/application/PatientService.java</exclude>
                        <exclude>**/application/PatientUseCases.java</exclude>
                        <exclude>**/application/PecService.java</exclude>
                        <exclude>**/application/PecUseCases.java</exclude>
                        <exclude>**/configuration/PatientCouvertureConfiguration.java</exclude>
                        <exclude>**/infrastructure/persistence/*Jdbc.java</exclude>
                        <exclude>**/interfaces/http/*Controleur.java</exclude>
                        <exclude>**/interfaces/http/dto/*Request.java</exclude>
                        <exclude>**/publishedlanguage/Assure*.java</exclude>
                        <exclude>**/publishedlanguage/Attestation*.java</exclude>
                        <exclude>**/publishedlanguage/PatientAdmis.java</exclude>
                        <exclude>**/publishedlanguage/PEC*.java</exclude>
                    </excludes>
                    <testExcludes>
                        <testExclude>**/domain/AssureTest.java</testExclude>
                        <testExclude>**/domain/PecTest.java</testExclude>
                    </testExcludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>