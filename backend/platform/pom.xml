<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.hemodialyse</groupId>
        <artifactId>backend-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>platform</artifactId>
    <name>platform</name>
    <description>Hemodialyse platform - application + infrastructure + bootstrap</description>
    <dependencies>
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-gmao</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-comptabilite</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-facturation</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-absences-patients</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Contexte Stock (ADR 0045) : référentiel et catalogue publié (slice S1) -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-stock</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Contexte Planification (ADR 0049 à 0054) : squelette, rempli slice par slice (P1 à P9) -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-planification</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Contexte Organisation (slice O5) : sociétés/centres + référentiels, cutover legacy -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-organisation</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Contexte Patient et couverture (slice PC1, refonte sur place, ADR 0024 et 0076) : fiche, mouvements, recherche -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-patient-couverture</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-dossier-medical</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Contexte Séance (SE1, ADR 0088) : module reconstruit sur place ; aucun contrôleur ni cas d'usage routé tant que la session B n'a pas câblé la parité -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-seance</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Contexte Pilotage direction (lot A = PD1 + PD4, ADR 0102) : tableau de bord et rapport de synthese ; memes URL /api/v1/direction/* -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-pilotage-direction</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Contexte Notifications (NOT1, ADR 0140, 0141) : journal, lecture, purge ; memes URL /api/v1/notifications -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-notifications</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Contexte Documents (DOC1, ADR 0140, 0142) : routes d'impression POST /api/v1/documents/print[/{modeleId}], papier en-tete ; le moteur Jasper reste ici jusqu'a DOC2 -->
        <dependency>
            <groupId>com.hemodialyse</groupId>
            <artifactId>contexts-documents</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>ai.timefold.solver</groupId>
            <artifactId>timefold-solver-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.13</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Frontière des contextes vue depuis le legacy (FrontieresDesContextesTest) : même version que les contextes -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.5.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
            <version>1.0.10</version>
        </dependency>
        <!-- Jasper et POI : portes par contexts-documents (DOC2, ADR 0162), transitifs ici -->
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>