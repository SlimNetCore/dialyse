<?xml version="1.0" encoding="UTF-8"?>
<!--
  Synthèse mensuelle de facturation (PL8, ADR 0147). AUCUNE requête : la Facturation fournit ses données (ADR 0140 D3) :
  les lignes du tableau forfait x caisse arrivent comme source de données (champs FORFAIT, COLONNE, HT, TTC ; COLONNE = rang sur 4 chiffres
  puis libellé de la caisse) et les totaux, indicateurs et répartitions comme paramètres. Le tableau croisé donne une colonne HT / TTC par
  caisse, quel qu'en soit le nombre.
-->
<jasperReport xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="synthese_mensuelle_facturation" pageWidth="842" pageHeight="595" orientation="Landscape"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" columnWidth="802">

    <parameter name="CENTER_ID" class="java.lang.String"/>
    <parameter name="PERIOD_START" class="java.lang.String"/>
    <parameter name="PERIOD_END" class="java.lang.String"/>
    <parameter name="DISTRIBUTION_BY_CAISSE_TEXT" class="java.lang.String"/>
    <parameter name="DISTRIBUTION_BY_STATUS_TEXT" class="java.lang.String"/>
    <parameter name="AVEC_GRAPHIQUE" class="java.lang.Boolean"/>
    <parameter name="TOTAL_PATIENTS" class="java.lang.Long"/>
    <parameter name="TOTAL_SEANCES" class="java.lang.Long"/>
    <parameter name="TOTAL_FACTURES" class="java.lang.Long"/>
    <!-- Totaux enregistrés des factures de la période (posés par le serveur, ADR 0034) -->
    <parameter name="TOTAL_HT_FACTURES" class="java.math.BigDecimal"/>
    <parameter name="TOTAL_TVA_FACTURES" class="java.math.BigDecimal"/>
    <parameter name="TOTAL_TTC_FACTURES" class="java.math.BigDecimal"/>

    <field name="FORFAIT" class="java.lang.String"/>
    <field name="COLONNE" class="java.lang.String"/>
    <field name="HT" class="java.math.BigDecimal"/>
    <field name="TTC" class="java.math.BigDecimal"/>

    <title>
        <band height="60">
            <staticText>
                <reportElement x="0" y="0" width="802" height="28"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[SYNTHESE MENSUELLE FACTURATION]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="34" width="401" height="16"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Centre: " + $P{CENTER_ID}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="401" y="34" width="401" height="16"/>
                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Periode: " + $P{PERIOD_START} + " au " + $P{PERIOD_END}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <summary>
        <band height="390">
            <crosstab>
                <reportElement x="0" y="0" width="802" height="52"/>
                <crosstabHeaderCell>
                    <cellContents backcolor="#1B5E20" mode="Opaque">
                        <staticText>
                            <reportElement x="0" y="0" width="150" height="34" forecolor="#FFFFFF"/>
                            <textElement textAlignment="Center" verticalAlignment="Middle">
                                <font size="8" isBold="true"/>
                            </textElement>
                            <text><![CDATA[Forfait]]></text>
                        </staticText>
                    </cellContents>
                </crosstabHeaderCell>
                <rowGroup name="forfait" width="150">
                    <bucket class="java.lang.String">
                        <bucketExpression><![CDATA[$F{FORFAIT}]]></bucketExpression>
                    </bucket>
                    <crosstabRowHeader>
                        <cellContents>
                            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                                <reportElement x="0" y="0" width="150" height="18"/>
                                <textElement>
                                    <font size="8"/>
                                </textElement>
                                <textFieldExpression><![CDATA[$V{forfait}]]></textFieldExpression>
                            </textField>
                        </cellContents>
                    </crosstabRowHeader>
                </rowGroup>
                <columnGroup name="caisse" height="34" totalPosition="End">
                    <bucket class="java.lang.String">
                        <bucketExpression><![CDATA[$F{COLONNE}]]></bucketExpression>
                    </bucket>
                    <crosstabColumnHeader>
                        <cellContents backcolor="#1B5E20" mode="Opaque">
                            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                                <reportElement x="0" y="0" width="130" height="20" forecolor="#FFFFFF"/>
                                <textElement textAlignment="Center" verticalAlignment="Middle">
                                    <font size="8" isBold="true"/>
                                </textElement>
                                <textFieldExpression><![CDATA[$V{caisse}.substring(4)]]></textFieldExpression>
                            </textField>
                            <staticText>
                                <reportElement x="0" y="20" width="65" height="14" forecolor="#FFFFFF"/>
                                <textElement textAlignment="Center">
                                    <font size="8" isBold="true"/>
                                </textElement>
                                <text><![CDATA[HT]]></text>
                            </staticText>
                            <staticText>
                                <reportElement x="65" y="20" width="65" height="14" forecolor="#FFFFFF"/>
                                <textElement textAlignment="Center">
                                    <font size="8" isBold="true"/>
                                </textElement>
                                <text><![CDATA[TTC]]></text>
                            </staticText>
                        </cellContents>
                    </crosstabColumnHeader>
                    <crosstabTotalColumnHeader>
                        <cellContents backcolor="#1B5E20" mode="Opaque">
                            <staticText>
                                <reportElement x="0" y="0" width="130" height="20" forecolor="#FFFFFF"/>
                                <textElement textAlignment="Center" verticalAlignment="Middle">
                                    <font size="8" isBold="true"/>
                                </textElement>
                                <text><![CDATA[Total]]></text>
                            </staticText>
                            <staticText>
                                <reportElement x="0" y="20" width="65" height="14" forecolor="#FFFFFF"/>
                                <textElement textAlignment="Center">
                                    <font size="8" isBold="true"/>
                                </textElement>
                                <text><![CDATA[Total HT]]></text>
                            </staticText>
                            <staticText>
                                <reportElement x="65" y="20" width="65" height="14" forecolor="#FFFFFF"/>
                                <textElement textAlignment="Center">
                                    <font size="8" isBold="true"/>
                                </textElement>
                                <text><![CDATA[Total TTC]]></text>
                            </staticText>
                        </cellContents>
                    </crosstabTotalColumnHeader>
                </columnGroup>
                <measure name="htMesure" class="java.math.BigDecimal" calculation="Sum">
                    <measureExpression><![CDATA[$F{HT}]]></measureExpression>
                </measure>
                <measure name="ttcMesure" class="java.math.BigDecimal" calculation="Sum">
                    <measureExpression><![CDATA[$F{TTC}]]></measureExpression>
                </measure>
                <crosstabCell width="130" height="18">
                    <cellContents>
                        <textField pattern="#,##0.00">
                            <reportElement x="0" y="0" width="65" height="18"/>
                            <textElement textAlignment="Right">
                                <font size="8"/>
                            </textElement>
                            <textFieldExpression><![CDATA[$V{htMesure} == null ? java.math.BigDecimal.ZERO : $V{htMesure}]]></textFieldExpression>
                        </textField>
                        <textField pattern="#,##0.00">
                            <reportElement x="65" y="0" width="65" height="18"/>
                            <textElement textAlignment="Right">
                                <font size="8"/>
                            </textElement>
                            <textFieldExpression><![CDATA[$V{ttcMesure} == null ? java.math.BigDecimal.ZERO : $V{ttcMesure}]]></textFieldExpression>
                        </textField>
                    </cellContents>
                </crosstabCell>
                <crosstabCell width="130" height="18" columnTotalGroup="caisse">
                    <cellContents>
                        <textField pattern="#,##0.00">
                            <reportElement x="0" y="0" width="65" height="18"/>
                            <textElement textAlignment="Right">
                                <font size="8" isBold="true"/>
                            </textElement>
                            <textFieldExpression><![CDATA[$V{htMesure} == null ? java.math.BigDecimal.ZERO : $V{htMesure}]]></textFieldExpression>
                        </textField>
                        <textField pattern="#,##0.00">
                            <reportElement x="65" y="0" width="65" height="18"/>
                            <textElement textAlignment="Right">
                                <font size="8" isBold="true"/>
                            </textElement>
                            <textFieldExpression><![CDATA[$V{ttcMesure} == null ? java.math.BigDecimal.ZERO : $V{ttcMesure}]]></textFieldExpression>
                        </textField>
                    </cellContents>
                </crosstabCell>
            </crosstab>

            <staticText>
                <reportElement positionType="Float" x="0" y="54" width="802" height="20"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Vue d'ensemble mensuelle]]></text>
            </staticText>

            <staticText>
                <reportElement positionType="Float" mode="Opaque" backcolor="#E8F5E9" x="0" y="74" width="130" height="16"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Montant HT]]></text>
            </staticText>
            <textField pattern="#,##0.00" isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement positionType="Float" mode="Opaque" backcolor="#E8F5E9" x="0" y="90" width="130" height="24"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_HT_FACTURES}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement positionType="Float" mode="Opaque" backcolor="#E3F2FD" x="134" y="74" width="130" height="16"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Montant TTC]]></text>
            </staticText>
            <textField pattern="#,##0.00" isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement positionType="Float" mode="Opaque" backcolor="#E3F2FD" x="134" y="90" width="130" height="24"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_TTC_FACTURES}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement positionType="Float" mode="Opaque" backcolor="#FFF8E1" x="268" y="74" width="130" height="16"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Patients]]></text>
            </staticText>
            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement positionType="Float" mode="Opaque" backcolor="#FFF8E1" x="268" y="90" width="130" height="24"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_PATIENTS}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement positionType="Float" mode="Opaque" backcolor="#F3E5F5" x="402" y="74" width="130" height="16"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Seances]]></text>
            </staticText>
            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement positionType="Float" mode="Opaque" backcolor="#F3E5F5" x="402" y="90" width="130" height="24"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_SEANCES}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement positionType="Float" mode="Opaque" backcolor="#ECEFF1" x="536" y="74" width="130" height="16"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Factures]]></text>
            </staticText>
            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement positionType="Float" mode="Opaque" backcolor="#ECEFF1" x="536" y="90" width="130" height="24"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_FACTURES}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement positionType="Float" mode="Opaque" backcolor="#FFEBEE" x="670" y="74" width="132" height="16"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Montant TVA]]></text>
            </staticText>
            <textField pattern="#,##0.00" isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement positionType="Float" mode="Opaque" backcolor="#FFEBEE" x="670" y="90" width="132" height="24"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_TVA_FACTURES}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement positionType="Float" x="0" y="118" width="802" height="1" forecolor="#B0BEC5"/>
            </line>
            <staticText>
                <reportElement positionType="Float" x="0" y="124" width="401" height="16"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Repartition patients/seances par caisse]]></text>
            </staticText>
            <staticText>
                <reportElement positionType="Float" x="409" y="124" width="393" height="16"/>
                <textElement textAlignment="Left"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Repartition patients/seances par situation patient]]></text>
            </staticText>
            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement positionType="Float" x="0" y="142" width="393" height="110"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{DISTRIBUTION_BY_CAISSE_TEXT}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement positionType="Float" x="409" y="142" width="393" height="110"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{DISTRIBUTION_BY_STATUS_TEXT}]]></textFieldExpression>
            </textField>

            <!-- Voie « modèles de documents » seulement (AVEC_GRAPHIQUE posé par le serveur) : TTC par forfait, une série par colonne -->
            <barChart>
                <chart>
                    <reportElement positionType="Float" isRemoveLineWhenBlank="true" x="0" y="258" width="802" height="130">
                        <printWhenExpression><![CDATA[$P{AVEC_GRAPHIQUE} != null && $P{AVEC_GRAPHIQUE}]]></printWhenExpression>
                    </reportElement>
                    <chartTitle/>
                </chart>
                <categoryDataset>
                    <categorySeries>
                        <seriesExpression><![CDATA[$F{COLONNE}.substring(4)]]></seriesExpression>
                        <categoryExpression><![CDATA[$F{FORFAIT}]]></categoryExpression>
                        <valueExpression><![CDATA[$F{TTC}]]></valueExpression>
                    </categorySeries>
                </categoryDataset>
                <barPlot>
                    <plot/>
                </barPlot>
            </barChart>
        </band>
    </summary>

</jasperReport>
