                <reportElement x="0" y="0" width="802" height="28"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[SYNTHESE MENSUELLE FACTURATION]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="34" width="410" height="16"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Centre: " + $P{CENTER_ID}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="420" y="34" width="382" height="16"/>
                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>
                <textFieldExpression>
                    <![CDATA["Periode: " + $P{PERIOD_START} + " au " + $P{PERIOD_END}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="58" width="802" height="1"/>
            </line>
        </band>
    </title>

