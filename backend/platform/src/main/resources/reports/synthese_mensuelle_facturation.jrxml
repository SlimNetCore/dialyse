<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="synthese_mensuelle_facturation" pageWidth="842" pageHeight="595" orientation="Landscape"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" columnWidth="802">

    <parameter name="CENTER_ID" class="java.lang.String"/>
    <parameter name="PERIOD_START" class="java.lang.String"/>
    <parameter name="PERIOD_END" class="java.lang.String"/>

    <queryString>
        <![CDATA[
        SELECT fl.forfait_label AS forfait_label,
               SUM(CASE WHEN UPPER(COALESCE(ca.code, '')) LIKE 'CNAS%' THEN fl.line_ht ELSE 0 END) AS cnas_ht,
               SUM(CASE WHEN UPPER(COALESCE(ca.code, '')) LIKE 'CNAS%' THEN (fl.line_ht * (1 + (f.tva_rate / 100))) ELSE 0 END) AS cnas_ttc,
               SUM(CASE WHEN UPPER(COALESCE(ca.code, '')) LIKE 'CASNOS%' THEN fl.line_ht ELSE 0 END) AS casnos_ht,
               SUM(CASE WHEN UPPER(COALESCE(ca.code, '')) LIKE 'CASNOS%' THEN (fl.line_ht * (1 + (f.tva_rate / 100))) ELSE 0 END) AS casnos_ttc,
               SUM(CASE WHEN UPPER(COALESCE(ca.code, '')) LIKE 'CAMSSP%' THEN fl.line_ht ELSE 0 END) AS camssp_ht,
               SUM(CASE WHEN UPPER(COALESCE(ca.code, '')) LIKE 'CAMSSP%' THEN (fl.line_ht * (1 + (f.tva_rate / 100))) ELSE 0 END) AS camssp_ttc,
               SUM(CASE WHEN UPPER(COALESCE(ca.code, '')) NOT LIKE 'CNAS%'
                         AND UPPER(COALESCE(ca.code, '')) NOT LIKE 'CASNOS%'
                         AND UPPER(COALESCE(ca.code, '')) NOT LIKE 'CAMSSP%'
                    THEN fl.line_ht ELSE 0 END) AS autres_ht,
               SUM(CASE WHEN UPPER(COALESCE(ca.code, '')) NOT LIKE 'CNAS%'
                         AND UPPER(COALESCE(ca.code, '')) NOT LIKE 'CASNOS%'
                         AND UPPER(COALESCE(ca.code, '')) NOT LIKE 'CAMSSP%'
                    THEN (fl.line_ht * (1 + (f.tva_rate / 100))) ELSE 0 END) AS autres_ttc,
               SUM(fl.line_ht) AS total_ht,
               SUM(fl.line_ht * (1 + (f.tva_rate / 100))) AS total_ttc
        FROM facture_lignes fl
        INNER JOIN factures f ON f.id = fl.facture_id AND f.center_id = fl.center_id
        LEFT JOIN agence a ON a.id = f.agence_id_snapshot AND a.center_id = f.center_id
        LEFT JOIN caisse_assurance ca ON ca.id = a.caisse_id AND ca.center_id = f.center_id
        WHERE f.center_id = CAST($P{CENTER_ID} AS UUID)
          AND f.date_facturation BETWEEN CAST($P{PERIOD_START} AS DATE) AND CAST($P{PERIOD_END} AS DATE)
        GROUP BY fl.forfait_label
        ORDER BY fl.forfait_label
        ]]>
    </queryString>

    <field name="FORFAIT_LABEL" class="java.lang.String"/>
    <field name="CNAS_HT" class="java.math.BigDecimal"/>
    <field name="CNAS_TTC" class="java.math.BigDecimal"/>
    <field name="CASNOS_HT" class="java.math.BigDecimal"/>
    <field name="CASNOS_TTC" class="java.math.BigDecimal"/>
    <field name="CAMSSP_HT" class="java.math.BigDecimal"/>
    <field name="CAMSSP_TTC" class="java.math.BigDecimal"/>
    <field name="AUTRES_HT" class="java.math.BigDecimal"/>
    <field name="AUTRES_TTC" class="java.math.BigDecimal"/>
    <field name="TOTAL_HT" class="java.math.BigDecimal"/>
    <field name="TOTAL_TTC" class="java.math.BigDecimal"/>

    <variable name="GLOBAL_TOTAL_HT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{TOTAL_HT}]]></variableExpression>
    </variable>
    <variable name="GLOBAL_TOTAL_TTC" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{TOTAL_TTC}]]></variableExpression>
    </variable>

    <title>
        <band height="70">
