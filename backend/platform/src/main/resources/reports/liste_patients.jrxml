<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="liste_patients" pageWidth="842" pageHeight="595"
              orientation="Landscape"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              columnWidth="802">

    <parameter name="CENTER_ID" class="java.lang.String"/>

    <queryString>
        <![CDATA[
        SELECT p.code_patient, p.nom, p.prenom, p.sexe, p.groupe_sanguin,
               p.date_naissance, p.date_admission, p.numero_assurance,
               p.tel_mobile, p.etat_patient, p.adresse
        FROM patients p
        WHERE p.center_id = CAST($P{CENTER_ID} AS UUID)
        ORDER BY p.nom, p.prenom
        ]]>
    </queryString>

    <field name="CODE_PATIENT" class="java.lang.String"/>
    <field name="NOM" class="java.lang.String"/>
    <field name="PRENOM" class="java.lang.String"/>
    <field name="SEXE" class="java.lang.String"/>
    <field name="GROUPE_SANGUIN" class="java.lang.String"/>
    <field name="DATE_NAISSANCE" class="java.sql.Date"/>
    <field name="DATE_ADMISSION" class="java.sql.Date"/>
    <field name="NUMERO_ASSURANCE" class="java.lang.String"/>
    <field name="TEL_MOBILE" class="java.lang.String"/>
    <field name="ETAT_PATIENT" class="java.lang.String"/>

    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="5" width="802" height="30"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[LISTE DES PATIENTS]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="40" width="802" height="1"/>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText>
                <reportElement x="0" y="0" width="60" height="20" backcolor="#1B5E20" forecolor="#FFFFFF"
                               mode="Opaque"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Code]]></text>
            </staticText>
            <staticText>
                <reportElement x="60" y="0" width="100" height="20" backcolor="#1B5E20" forecolor="#FFFFFF"
                               mode="Opaque"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Nom]]></text>
            </staticText>
            <staticText>
                <reportElement x="160" y="0" width="100" height="20" backcolor="#1B5E20" forecolor="#FFFFFF"
                               mode="Opaque"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Prénom]]></text>
            </staticText>
            <staticText>
                <reportElement x="260" y="0" width="50" height="20" backcolor="#1B5E20" forecolor="#FFFFFF"
                               mode="Opaque"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Sexe]]></text>
            </staticText>
            <staticText>
                <reportElement x="310" y="0" width="40" height="20" backcolor="#1B5E20" forecolor="#FFFFFF"
                               mode="Opaque"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[GS]]></text>
            </staticText>
            <staticText>
                <reportElement x="350" y="0" width="80" height="20" backcolor="#1B5E20" forecolor="#FFFFFF"
                               mode="Opaque"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Naissance]]></text>
            </staticText>
            <staticText>
                <reportElement x="430" y="0" width="80" height="20" backcolor="#1B5E20" forecolor="#FFFFFF"
                               mode="Opaque"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Admission]]></text>
            </staticText>
            <staticText>
                <reportElement x="510" y="0" width="100" height="20" backcolor="#1B5E20" forecolor="#FFFFFF"
                               mode="Opaque"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[N° Assurance]]></text>
            </staticText>
            <staticText>
                <reportElement x="610" y="0" width="90" height="20" backcolor="#1B5E20" forecolor="#FFFFFF"
                               mode="Opaque"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Tél mobile]]></text>
            </staticText>
            <staticText>
                <reportElement x="700" y="0" width="102" height="20" backcolor="#1B5E20" forecolor="#FFFFFF"
                               mode="Opaque"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[État]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="60" height="14"/>
                <textElement textAlignment="Center">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{CODE_PATIENT}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="60" y="0" width="100" height="14"/>
                <textElement>
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{NOM}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="160" y="0" width="100" height="14"/>
                <textElement>
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{PRENOM}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="260" y="0" width="50" height="14"/>
                <textElement textAlignment="Center">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{SEXE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="310" y="0" width="40" height="14"/>
                <textElement textAlignment="Center">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{GROUPE_SANGUIN}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="350" y="0" width="80" height="14"/>
                <textElement textAlignment="Center">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{DATE_NAISSANCE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="430" y="0" width="80" height="14"/>
                <textElement textAlignment="Center">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{DATE_ADMISSION}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="510" y="0" width="100" height="14"/>
                <textElement textAlignment="Center">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{NUMERO_ASSURANCE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="610" y="0" width="90" height="14"/>
                <textElement textAlignment="Center">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{TEL_MOBILE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="700" y="0" width="102" height="14"/>
                <textElement textAlignment="Center">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{ETAT_PATIENT}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="24">
            <textField>
                <reportElement x="0" y="4" width="200" height="14"/>
                <textElement>
                    <font size="7" isItalic="true"/>
                </textElement>
                <textFieldExpression>
                    <![CDATA["Imprimé le " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="600" y="4" width="202" height="14"/>
                <textElement textAlignment="Right">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>

