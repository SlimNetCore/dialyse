            </textField>
            <staticText>
                <reportElement x="0" y="146" width="260" height="14"/>
                <textElement>
                    <font size="8" isItalic="true"/>
                </textElement>
                <text><![CDATA[Signature :]]></text>
            </staticText>
            <staticText>
                <reportElement x="275" y="146" width="260" height="14"/>
                <textElement>
                    <font size="8" isItalic="true"/>
                </textElement>
                <text><![CDATA[Signature et cachet de l'intervenant :]]></text>
            </staticText>
            <rectangle>
                <reportElement x="0" y="162" width="260" height="46" backcolor="#FFFFFF"/>
                <graphicElement>
                    <pen lineWidth="0.5"/>
                </graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="275" y="162" width="260" height="46" backcolor="#FFFFFF"/>
                <graphicElement>
                    <pen lineWidth="0.5"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="0" y="220" width="535" height="16" backcolor="#E8F5E9" mode="Opaque"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[  Ligne de temps]]></text>
            </staticText>
            <textField isBlankWhenNull="true" isStretchWithOverflow="true">
                <reportElement x="0" y="240" width="535" height="40"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CHRONOLOGIE}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
