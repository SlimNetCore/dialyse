            <textField isBlankWhenNull="true">
                <reportElement x="0" y="127" width="260" height="14"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SIGNATAIRE_CREE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="275" y="127" width="260" height="14"/>
                <textElement>
