                    </textElement>
                    <textFieldExpression>
                        <![CDATA["Résultats biologiques : " + $F{MED_RESULTATS}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true" isStretchWithOverflow="true">
                    <reportElement positionType="Float" x="0" y="258" width="539" height="14"/>
                    <textElement>
                        <font size="8.5"/>
                    </textElement>
                    <textFieldExpression>
                        <![CDATA["Ajustements thérapeutiques : " + $F{MED_AJUSTEMENTS}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true" isStretchWithOverflow="true">
                    <reportElement positionType="Float" x="0" y="272" width="539" height="14"/>
                    <textElement>
                        <font size="8.5"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Conclusion médicale : " + $F{MED_CONCLUSION}]]></textFieldExpression>
                </textField>
