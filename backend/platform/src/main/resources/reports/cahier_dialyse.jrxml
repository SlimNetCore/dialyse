    </group>

    <pageHeader>
        <band height="96">
            <image scaleImage="RetainShape" hAlign="Left" vAlign="Top" onErrorType="Blank">
                <reportElement x="0" y="0" width="60" height="50">
                    <printWhenExpression><![CDATA[$P{SOCIETE_LOGO} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{SOCIETE_LOGO}]]></imageExpression>
            </image>
            <textField isBlankWhenNull="true">
                <reportElement x="66" y="0" width="290" height="15"/>
                <textElement textAlignment="Left">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SOCIETE_NOM}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="66" y="16" width="290" height="24"/>
