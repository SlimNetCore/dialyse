                </textElement>
                <textFieldExpression><![CDATA[$P{CENTRE_ADRESSE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="362" y="28" width="177" height="22"/>
                <textElement textAlignment="Right">
                    <font size="7.5"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CENTRE_CONTACT}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="55" width="539" height="1" forecolor="#1B5E20"/>
            </line>
            <staticText>
                <reportElement x="0" y="60" width="539" height="20" forecolor="#1B5E20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[CAHIER DE DIALYSE]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="81" width="539" height="13"/>
