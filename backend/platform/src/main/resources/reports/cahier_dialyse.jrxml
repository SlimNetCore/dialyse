                    <font size="8.5"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{PATIENT_LIGNE}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <detail>
        <band height="16">
            <printWhenExpression><![CDATA[$F{ARTICLE_CODE} != null]]></printWhenExpression>
            <textField isBlankWhenNull="true" isStretchWithOverflow="true">
                <reportElement x="0" y="1" width="250" height="14"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression>
                    <![CDATA["  " + $F{ARTICLE_CODE} + ($F{ARTICLE_LIBELLE} != null ? " — " + $F{ARTICLE_LIBELLE} : "")]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.##" isBlankWhenNull="true">
                <reportElement x="250" y="1" width="70" height="14"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{QUANTITE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="320" y="1" width="50" height="14"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression>
                    <![CDATA[" " + ($F{ARTICLE_UNITE} != null ? $F{ARTICLE_UNITE} : "")]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="370" y="1" width="85" height="14"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{VALEUR_UNITAIRE}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="455" y="1" width="84" height="14"/>
                <textElement textAlignment="Right">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{TOTAL_VALORISE}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="15" width="539" height="1" forecolor="#CCCCCC"/>
            </line>
        </band>
    </detail>

    <pageFooter>
        <band height="46">
            <line>
                <reportElement x="0" y="3" width="539" height="1" forecolor="#1B5E20"/>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="6" width="400" height="12"/>
