                </frame>
                <textField textAdjust="StretchHeight">
                    <reportElement style="muted" x="0" y="116" width="539" height="30"/>
                    <textElement textAlignment="Justified"/>
                    <textFieldExpression><![CDATA["Les soussignés certifient l'exactitude du comptage physique ci-dessus. À la clôture, les quantités comptées "
                        + "constituent le stock de départ de chaque lot au " + $P{INV_DATE} + " ; les mouvements antérieurs sont clôturés "
                        + "et les écarts sont valorisés au prix moyen pondéré (PMP) figé à l'ouverture de l'inventaire."]]></textFieldExpression>
                </textField>
            </frame>
        </band>
    </summary>
</jasperReport>

