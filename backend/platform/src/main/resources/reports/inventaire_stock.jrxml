                    <reportElement style="expiry" x="84" y="0" width="54" height="14"/>
                    <textFieldExpression><![CDATA[$F{DATE_PEREMPTION}]]></textFieldExpression>
                </textField>
                <textField pattern="#,##0.###" isBlankWhenNull="true">
                    <reportElement style="cell" x="138" y="0" width="50" height="14"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA[$F{QUANTITE_THEORIQUE}]]></textFieldExpression>
                </textField>
                <textField pattern="#,##0.###" isBlankWhenNull="true">
                    <reportElement style="cell" x="188" y="0" width="50" height="14">
                        <printWhenExpression><![CDATA[$F{QUANTITE_COMPTEE} != null]]></printWhenExpression>
                    </reportElement>
                    <textElement textAlignment="Right">
                        <font isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{QUANTITE_COMPTEE}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement style="cell" x="188" y="0" width="50" height="14" forecolor="#9AA5B1">
                        <printWhenExpression><![CDATA[$F{QUANTITE_COMPTEE} == null]]></printWhenExpression>
                    </reportElement>
                    <textElement textAlignment="Right">
                        <font size="6.5" isItalic="true"/>
                    </textElement>
                    <text><![CDATA[non compté]]></text>
                </staticText>
                <textField pattern="+#,##0.###;-#,##0.###" isBlankWhenNull="true">
                    <reportElement style="gap" x="238" y="0" width="46" height="14"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression>
                        <![CDATA[$F{ECART} != null && $F{ECART}.doubleValue() == 0 ? null : $F{ECART}]]></textFieldExpression>
                </textField>
                <textField pattern="#,##0.00" isBlankWhenNull="true">
                    <reportElement style="cell" x="284" y="0" width="56" height="14" forecolor="#627D98"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA[$F{PMP}]]></textFieldExpression>
                </textField>
                <textField pattern="+#,##0.00;-#,##0.00" isBlankWhenNull="true">
