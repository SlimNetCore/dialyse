<?xml version="1.0" encoding="UTF-8"?>
<!--
  Procès-verbal d'inventaire de stock (modèle de document INVENTAIRE_STOCK, personnalisable par centre).
  - En-tête (logo, société, centre) et pied de page (centre, pied de page société, édition, pagination) sur chaque page.
  - Page 1 : titre, statut, indicateurs clés (calculés par le serveur).
  - Détail du comptage par article et par lot (sous-totaux), analyse des écarts par motif, observations, validation.
  - Filigrane « PROVISOIRE » / « ANNULÉ » tant que l'inventaire n'est pas clôturé.
  Contraintes « modèle personnalisable » (JrxmlSecurityValidator) : une seule requête, expressions simples, police
  standard. Valorisation au PMP figé à l'ouverture de l'inventaire.
-->
<jasperReport xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="inventaire_stock" pageWidth="595" pageHeight="842" columnWidth="539"
              leftMargin="28" rightMargin="28" topMargin="24" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail" isSummaryWithPageHeaderAndFooter="true">

    <!-- ───────────────────────────── Styles ───────────────────────────── -->
    <style name="base" isDefault="true" fontSize="7.5" forecolor="#1F2933"/>
    <style name="muted" fontSize="6.8" forecolor="#627D98"/>
    <style name="h2" fontSize="10" isBold="true" forecolor="#0D5750" vTextAlign="Bottom">
        <box bottomPadding="2">
            <bottomPen lineWidth="0.75" lineColor="#BCCCDC"/>
        </box>
    </style>
    <style name="th" mode="Opaque" backcolor="#0D5750" forecolor="#FFFFFF" fontSize="6.5" isBold="true"
           vTextAlign="Middle">
        <box leftPadding="4" rightPadding="4"/>
    </style>
    <style name="cell" vTextAlign="Middle">
        <box leftPadding="4" rightPadding="4"/>
    </style>
    <style name="zebra" mode="Transparent">
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{ROW_IN_GROUP} % 2 == 0]]></conditionExpression>
            <style mode="Opaque" backcolor="#F7FAFC"/>
        </conditionalStyle>
    </style>
    <style name="gap" style="cell">
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{ECART} != null && $F{ECART}.doubleValue() < 0]]></conditionExpression>
            <style forecolor="#B42318" isBold="true"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{ECART} != null && $F{ECART}.doubleValue() > 0]]></conditionExpression>
            <style forecolor="#067647" isBold="true"/>
        </conditionalStyle>
    </style>
    <style name="groupGap" style="cell" isBold="true">
        <conditionalStyle>
            <conditionExpression>
                <![CDATA[$V{G_VAL_ECART} != null && $V{G_VAL_ECART}.doubleValue() < 0]]></conditionExpression>
            <style forecolor="#B42318"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression>
                <![CDATA[$V{G_VAL_ECART} != null && $V{G_VAL_ECART}.doubleValue() > 0]]></conditionExpression>
            <style forecolor="#067647"/>
        </conditionalStyle>
    </style>
    <style name="totalGap" isBold="true" forecolor="#0D5750">
        <conditionalStyle>
            <conditionExpression>
                <![CDATA[$P{INV_ECART_SIGNE} != null && $P{INV_ECART_SIGNE} < 0]]></conditionExpression>
            <style forecolor="#B42318"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression>
                <![CDATA[$P{INV_ECART_SIGNE} != null && $P{INV_ECART_SIGNE} > 0]]></conditionExpression>
            <style forecolor="#067647"/>
        </conditionalStyle>
    </style>
    <style name="expiry" style="cell">
        <conditionalStyle>
            <conditionExpression><![CDATA["EXPIRE".equals($F{PEREMPTION_ETAT})]]></conditionExpression>
            <style forecolor="#B42318" isBold="true"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA["PROCHE".equals($F{PEREMPTION_ETAT})]]></conditionExpression>
            <style forecolor="#B54708"/>
        </conditionalStyle>
    </style>
    <style name="motif" style="cell">
        <conditionalStyle>
            <conditionExpression><![CDATA["À justifier".equals($F{MOTIF})]]></conditionExpression>
            <style forecolor="#B42318" isItalic="true"/>
        </conditionalStyle>
    </style>
    <style name="pill" mode="Opaque" backcolor="#EEF2F6" forecolor="#52606D" fontSize="6.8" isBold="true"
           hTextAlign="Center" vTextAlign="Middle">
        <box>
            <pen lineWidth="0.5" lineColor="#CBD2D9"/>
        </box>
        <conditionalStyle>
            <conditionExpression><![CDATA["CLOTURE".equals($P{INV_STATUT})]]></conditionExpression>
            <style backcolor="#E3F9E5" forecolor="#05603A">
                <box>
                    <pen lineWidth="0.5" lineColor="#A3E4B1"/>
                </box>
            </style>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA["EN_COURS".equals($P{INV_STATUT})]]></conditionExpression>
            <style backcolor="#FFF4D6" forecolor="#8A5A00">
                <box>
                    <pen lineWidth="0.5" lineColor="#F5C35B"/>
                </box>
            </style>
        </conditionalStyle>
    </style>
    <style name="kpiCard" mode="Opaque" backcolor="#F5F9FA">
        <box topPadding="4" leftPadding="6" rightPadding="4">
            <pen lineWidth="0.5" lineColor="#D9E2EC"/>
        </box>
    </style>
    <style name="kpiLabel" fontSize="5.8" forecolor="#627D98" isBold="true"/>
    <style name="kpiValue" fontSize="10.5" forecolor="#0D5750" isBold="true"/>

    <!-- ───────────────────────────── Paramètres ───────────────────────────── -->
    <parameter name="CENTER_ID" class="java.lang.String"/>
    <parameter name="INVENTAIRE_ID" class="java.lang.String"/>
    <parameter name="INV_REFERENCE" class="java.lang.String"/>
    <parameter name="INV_DATE" class="java.lang.String"/>
    <parameter name="INV_STATUT" class="java.lang.String"/>
    <parameter name="INV_STATUT_LIBELLE" class="java.lang.String"/>
    <parameter name="INV_COMMENTAIRE" class="java.lang.String"/>
    <parameter name="INV_OUVERT" class="java.lang.String"/>
    <parameter name="INV_CLOTURE_LIBELLE" class="java.lang.String"/>
    <parameter name="INV_CLOTURE" class="java.lang.String"/>
    <parameter name="INV_NOTICE" class="java.lang.String"/>
    <parameter name="INV_FILIGRANE" class="java.lang.String"/>
    <parameter name="INV_ECART_SIGNE" class="java.lang.Integer"/>
    <parameter name="KPI_ARTICLES_LOTS" class="java.lang.String"/>
    <parameter name="KPI_COMPTES" class="java.lang.String"/>
    <parameter name="KPI_AVANCEMENT" class="java.lang.String"/>
    <parameter name="KPI_ECARTS" class="java.lang.String"/>
    <parameter name="KPI_ECARTS_PART" class="java.lang.String"/>
    <parameter name="KPI_VAL_THEO" class="java.lang.String"/>
    <parameter name="KPI_VAL_COMPTE" class="java.lang.String"/>
    <parameter name="KPI_VAL_ECART" class="java.lang.String"/>
    <parameter name="KPI_VAL_ECART_PART" class="java.lang.String"/>
    <parameter name="MOTIFS_PRESENTS" class="java.lang.Boolean"/>
    <parameter name="MOTIFS_LIBELLES" class="java.lang.String"/>
    <parameter name="MOTIFS_LOTS" class="java.lang.String"/>
    <parameter name="MOTIFS_MANQUANTS" class="java.lang.String"/>
    <parameter name="MOTIFS_EXCEDENTS" class="java.lang.String"/>
    <parameter name="MOTIFS_NETS" class="java.lang.String"/>
    <parameter name="MOTIFS_TOTAL_LOTS" class="java.lang.String"/>
    <parameter name="MOTIFS_TOTAL_MANQUANTS" class="java.lang.String"/>
    <parameter name="MOTIFS_TOTAL_EXCEDENTS" class="java.lang.String"/>
    <parameter name="MOTIFS_TOTAL_NET" class="java.lang.String"/>
    <parameter name="SIGNATAIRE_ETABLI" class="java.lang.String"/>
    <parameter name="SIGNATAIRE_VERIFIE" class="java.lang.String"/>
    <parameter name="EDITE_LE" class="java.lang.String"/>
    <parameter name="EDITE_PAR" class="java.lang.String"/>
    <parameter name="SOCIETE_NOM" class="java.lang.String"/>
    <parameter name="SOCIETE_ADRESSE" class="java.lang.String"/>
    <parameter name="SOCIETE_TELEPHONE" class="java.lang.String"/>
    <parameter name="SOCIETE_EMAIL" class="java.lang.String"/>
    <parameter name="SOCIETE_SITE_WEB" class="java.lang.String"/>
    <parameter name="SOCIETE_CONTACT" class="java.lang.String"/>
    <parameter name="SOCIETE_LEGAL" class="java.lang.String"/>
    <parameter name="SOCIETE_PIED_PAGE" class="java.lang.String"/>
    <parameter name="SOCIETE_LOGO" class="java.io.InputStream"/>
    <parameter name="CENTRE_NOM" class="java.lang.String"/>
    <parameter name="CENTRE_ADRESSE" class="java.lang.String"/>
    <parameter name="CENTRE_TELEPHONE" class="java.lang.String"/>
    <parameter name="CENTRE_EMAIL" class="java.lang.String"/>
    <parameter name="CENTRE_SITE_WEB" class="java.lang.String"/>
    <parameter name="CENTRE_CONTACT" class="java.lang.String"/>
    <parameter name="CENTRE_LIGNE" class="java.lang.String"/>

    <queryString>
        <![CDATA[
        SELECT CAST(l.article_id AS VARCHAR(36)) AS ARTICLE_KEY,
               l.article_code AS ARTICLE_CODE, l.article_libelle AS ARTICLE_LIBELLE, l.unite AS UNITE,
               COALESCE(l.numero_lot, 'sans lot') || CASE WHEN l.ajoutee THEN ' (trouvé)' ELSE '' END AS LOT_LIBELLE,
               l.date_peremption AS DATE_PEREMPTION,
               CASE WHEN l.date_peremption IS NULL THEN NULL
                    WHEN l.date_peremption < CURRENT_DATE THEN 'EXPIRE'
                    WHEN l.date_peremption <= CURRENT_DATE + INTERVAL '90' DAY THEN 'PROCHE'
                    ELSE NULL END AS PEREMPTION_ETAT,
               l.quantite_theorique AS QUANTITE_THEORIQUE, l.quantite_comptee AS QUANTITE_COMPTEE,
               CASE WHEN l.quantite_comptee IS NULL THEN 1 ELSE 0 END AS NON_COMPTE,
               l.quantite_comptee - l.quantite_theorique AS ECART,
               COALESCE(l.pmp, 0) AS PMP,
               ROUND((l.quantite_comptee - l.quantite_theorique) * COALESCE(l.pmp, 0), 2) AS VAL_ECART,
               l.compte_par AS COMPTE_PAR,
               CASE
                   WHEN l.motif_ecart = 'CASSE' THEN 'Casse'
                   WHEN l.motif_ecart = 'PEREMPTION' THEN 'Péremption'
                   WHEN l.motif_ecart = 'ERREUR_SAISIE' THEN 'Erreur de saisie'
                   WHEN l.motif_ecart = 'PERTE' THEN 'Perte / vol'
                   WHEN l.motif_ecart = 'NON_ENREGISTRE' THEN 'Mouvement non enregistré'
                   WHEN l.motif_ecart = 'RETOUR' THEN 'Retour'
                   WHEN l.motif_ecart = 'AUTRE' THEN 'Autre'
                   WHEN l.motif_ecart IS NOT NULL THEN l.motif_ecart
                   WHEN l.quantite_comptee IS NOT NULL AND l.quantite_comptee <> l.quantite_theorique THEN 'À justifier'
                   ELSE NULL END AS MOTIF
        FROM inventaire_lignes l
        WHERE l.inventaire_id = CAST($P{INVENTAIRE_ID} AS UUID)
          AND l.center_id = CAST($P{CENTER_ID} AS UUID)
        ORDER BY LOWER(COALESCE(l.article_libelle, '')), l.article_id, l.date_peremption, l.position_ligne
        ]]>
    </queryString>

    <field name="ARTICLE_KEY" class="java.lang.String"/>
    <field name="ARTICLE_CODE" class="java.lang.String"/>
    <field name="ARTICLE_LIBELLE" class="java.lang.String"/>
    <field name="UNITE" class="java.lang.String"/>
    <field name="LOT_LIBELLE" class="java.lang.String"/>
    <field name="DATE_PEREMPTION" class="java.sql.Date"/>
    <field name="PEREMPTION_ETAT" class="java.lang.String"/>
    <field name="QUANTITE_THEORIQUE" class="java.math.BigDecimal"/>
    <field name="QUANTITE_COMPTEE" class="java.math.BigDecimal"/>
    <field name="NON_COMPTE" class="java.lang.Integer"/>
    <field name="ECART" class="java.math.BigDecimal"/>
    <field name="PMP" class="java.math.BigDecimal"/>
    <field name="VAL_ECART" class="java.math.BigDecimal"/>
    <field name="COMPTE_PAR" class="java.lang.String"/>
    <field name="MOTIF" class="java.lang.String"/>

    <!-- ───────────────────────────── Variables (par article) ───────────────────────────── -->
    <variable name="ROW_IN_GROUP" class="java.lang.Integer" resetType="Group" resetGroup="article" calculation="Count">
        <variableExpression><![CDATA[$F{ARTICLE_KEY}]]></variableExpression>
    </variable>
    <variable name="G_THEO" class="java.math.BigDecimal" resetType="Group" resetGroup="article" calculation="Sum">
        <variableExpression><![CDATA[$F{QUANTITE_THEORIQUE}]]></variableExpression>
    </variable>
    <variable name="G_COMPTE" class="java.math.BigDecimal" resetType="Group" resetGroup="article" calculation="Sum">
        <variableExpression><![CDATA[$F{QUANTITE_COMPTEE}]]></variableExpression>
    </variable>
    <variable name="G_ECART" class="java.math.BigDecimal" resetType="Group" resetGroup="article" calculation="Sum">
        <variableExpression><![CDATA[$F{ECART}]]></variableExpression>
    </variable>
    <variable name="G_VAL_ECART" class="java.math.BigDecimal" resetType="Group" resetGroup="article" calculation="Sum">
        <variableExpression><![CDATA[$F{VAL_ECART}]]></variableExpression>
    </variable>
    <variable name="G_NON_COMPTES" class="java.lang.Integer" resetType="Group" resetGroup="article" calculation="Sum">
        <variableExpression><![CDATA[$F{NON_COMPTE}]]></variableExpression>
    </variable>

    <!-- ───────────────────────────── Regroupement par article ───────────────────────────── -->
    <group name="article" keepTogether="true" minHeightToStartNewPage="48">
        <groupExpression><![CDATA[$F{ARTICLE_KEY}]]></groupExpression>
        <groupHeader>
            <band height="17">
                <frame>
                    <reportElement x="0" y="2" width="539" height="15" mode="Opaque" backcolor="#E6F0EF"/>
                    <box>
                        <leftPen lineWidth="2" lineColor="#0D5750"/>
                    </box>
                    <textField textAdjust="ScaleFont">
                        <reportElement style="cell" x="2" y="0" width="380" height="15" forecolor="#0D5750"/>
                        <textElement>
                            <font size="8" isBold="true"/>
                        </textElement>
                        <textFieldExpression>
                            <![CDATA[$F{ARTICLE_LIBELLE} == null ? "Article" : $F{ARTICLE_LIBELLE}]]></textFieldExpression>
                    </textField>
                    <textField>
                        <reportElement style="cell" x="382" y="0" width="155" height="15" forecolor="#486581"/>
                        <textElement textAlignment="Right">
                            <font size="6.8"/>
                        </textElement>
                        <textFieldExpression><![CDATA[($F{ARTICLE_CODE} == null ? "" : "Code " + $F{ARTICLE_CODE})
                            + ($F{UNITE} == null ? "" : "  ·  Unité : " + $F{UNITE})]]></textFieldExpression>
                    </textField>
                </frame>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="18">
                <frame>
                    <reportElement x="0" y="0" width="539" height="14" mode="Opaque" backcolor="#F4F8F8"/>
                    <box>
                        <topPen lineWidth="0.75" lineColor="#0D5750"/>
                    </box>
                    <textField>
                        <reportElement style="cell" x="0" y="0" width="138" height="14" forecolor="#486581"/>
                        <textElement>
                            <font size="6.8" isItalic="true"/>
                        </textElement>
                        <textFieldExpression><![CDATA["Sous-total · " + $V{ROW_IN_GROUP} + ($V{ROW_IN_GROUP} > 1 ? " lots" : " lot")
                            + ($V{G_NON_COMPTES} != null && $V{G_NON_COMPTES} > 0 ? " · " + $V{G_NON_COMPTES} + " non compté(s)" : "")]]></textFieldExpression>
                    </textField>
                    <textField pattern="#,##0.###" isBlankWhenNull="true">
                        <reportElement style="cell" x="138" y="0" width="50" height="14"/>
                        <textElement textAlignment="Right">
                            <font isBold="true"/>
                        </textElement>
                        <textFieldExpression><![CDATA[$V{G_THEO}]]></textFieldExpression>
                    </textField>
                    <textField pattern="#,##0.###" isBlankWhenNull="true">
                        <reportElement style="cell" x="188" y="0" width="50" height="14"/>
                        <textElement textAlignment="Right">
                            <font isBold="true"/>
                        </textElement>
                        <textFieldExpression><![CDATA[$V{G_COMPTE}]]></textFieldExpression>
                    </textField>
                    <textField pattern="+#,##0.###;-#,##0.###" isBlankWhenNull="true">
                        <reportElement style="groupGap" x="238" y="0" width="46" height="14">
                            <printWhenExpression>
                                <![CDATA[$V{G_NON_COMPTES} == null || $V{G_NON_COMPTES} == 0]]></printWhenExpression>
                        </reportElement>
                        <textElement textAlignment="Right"/>
                        <textFieldExpression><![CDATA[$V{G_ECART}]]></textFieldExpression>
                    </textField>
                    <textField pattern="+#,##0.00 DA;-#,##0.00 DA" isBlankWhenNull="true">
                        <reportElement style="groupGap" x="340" y="0" width="66" height="14"/>
                        <textElement textAlignment="Right"/>
                        <textFieldExpression><![CDATA[$V{G_VAL_ECART}]]></textFieldExpression>
                    </textField>
                </frame>
            </band>
        </groupFooter>
    </group>

    <!-- ───────────────────────────── Filigrane ───────────────────────────── -->
    <background>
        <band height="798">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="330" width="539" height="110" forecolor="#F6D5D1">
                    <printWhenExpression><![CDATA[$P{INV_FILIGRANE} != null]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="78" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{INV_FILIGRANE}]]></textFieldExpression>
            </textField>
        </band>
    </background>

    <!-- ───────────────────────────── Titre (page 1) ───────────────────────────── -->
    <title>
        <band height="162">
            <staticText>
                <reportElement x="0" y="4" width="360" height="10" forecolor="#C9A227"/>
                <textElement>
                    <font size="6.5" isBold="true"/>
                </textElement>
                <text><![CDATA[PROCÈS-VERBAL D'INVENTAIRE PHYSIQUE DU STOCK]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="15" width="360" height="24" forecolor="#102A43"/>
                <textElement>
                    <font size="17" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Inventaire au " + $P{INV_DATE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="41" width="150" height="14" forecolor="#486581"/>
                <textElement verticalAlignment="Middle">
                    <font size="8.5"/>
                </textElement>
                <textFieldExpression><![CDATA["Réf. " + $P{INV_REFERENCE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="pill" x="150" y="42" width="62" height="12"/>
                <textFieldExpression><![CDATA[$P{INV_STATUT_LIBELLE}]]></textFieldExpression>
            </textField>

            <frame>
                <reportElement x="365" y="6" width="174" height="50"/>
                <box leftPadding="8">
                    <leftPen lineWidth="0.75" lineColor="#C9A227"/>
                </box>
                <staticText>
                    <reportElement style="muted" x="0" y="0" width="166" height="9"/>
                    <text><![CDATA[Ouverture]]></text>
                </staticText>
                <textField isBlankWhenNull="true">
                    <reportElement x="0" y="9" width="166" height="10" forecolor="#243B53"/>
                    <textElement>
                        <font size="7.2" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$P{INV_OUVERT}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement style="muted" x="0" y="21" width="166" height="9"/>
                    <textFieldExpression><![CDATA[$P{INV_CLOTURE_LIBELLE}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="0" y="30" width="166" height="10" forecolor="#243B53"/>
                    <textElement>
                        <font size="7.2" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$P{INV_CLOTURE}]]></textFieldExpression>
                </textField>
                <staticText>
                    <reportElement style="muted" x="0" y="41" width="166" height="9"/>
                    <text><![CDATA[Valorisation au PMP figé à l'ouverture]]></text>
                </staticText>
            </frame>

            <frame>
                <reportElement x="0" y="62" width="539" height="20" mode="Opaque" backcolor="#FFFBEA"
                               isRemoveLineWhenBlank="true">
                    <printWhenExpression><![CDATA[$P{INV_NOTICE} != null]]></printWhenExpression>
                </reportElement>
                <box leftPadding="8" rightPadding="6">
                    <leftPen lineWidth="2.5" lineColor="#F0B429"/>
                </box>
                <textField isBlankWhenNull="true">
                    <reportElement x="0" y="0" width="525" height="20" forecolor="#8A5A00"/>
                    <textElement verticalAlignment="Middle">
                        <font size="7.2"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$P{INV_NOTICE}]]></textFieldExpression>
                </textField>
            </frame>

            <!-- Indicateurs clés -->
            <frame>
                <reportElement style="kpiCard" positionType="Float" x="0" y="90" width="84" height="44"/>
                <staticText>
                    <reportElement style="kpiLabel" x="0" y="0" width="74" height="9"/>
                    <text><![CDATA[ARTICLES / LOTS]]></text>
                </staticText>
                <textField isBlankWhenNull="true">
                    <reportElement style="kpiValue" x="0" y="10" width="74" height="16"/>
                    <textFieldExpression><![CDATA[$P{KPI_ARTICLES_LOTS}]]></textFieldExpression>
                </textField>
            </frame>
            <frame>
                <reportElement style="kpiCard" positionType="Float" x="91" y="90" width="84" height="44"/>
                <staticText>
                    <reportElement style="kpiLabel" x="0" y="0" width="74" height="9"/>
                    <text><![CDATA[LOTS COMPTÉS]]></text>
                </staticText>
                <textField isBlankWhenNull="true">
                    <reportElement style="kpiValue" x="0" y="10" width="74" height="16"/>
                    <textFieldExpression><![CDATA[$P{KPI_COMPTES}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement style="muted" x="0" y="27" width="74" height="9"/>
                    <textFieldExpression><![CDATA[$P{KPI_AVANCEMENT}]]></textFieldExpression>
                </textField>
            </frame>
            <frame>
                <reportElement style="kpiCard" positionType="Float" x="182" y="90" width="84" height="44"/>
                <staticText>
                    <reportElement style="kpiLabel" x="0" y="0" width="74" height="9"/>
                    <text><![CDATA[LOTS EN ÉCART]]></text>
                </staticText>
                <textField isBlankWhenNull="true">
                    <reportElement style="kpiValue" x="0" y="10" width="74" height="16"/>
                    <textFieldExpression><![CDATA[$P{KPI_ECARTS}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement style="muted" x="0" y="27" width="74" height="9"/>
                    <textFieldExpression><![CDATA[$P{KPI_ECARTS_PART}]]></textFieldExpression>
                </textField>
            </frame>
            <frame>
                <reportElement style="kpiCard" positionType="Float" x="273" y="90" width="84" height="44"/>
                <staticText>
                    <reportElement style="kpiLabel" x="0" y="0" width="74" height="9"/>
                    <text><![CDATA[VALEUR THÉORIQUE]]></text>
                </staticText>
                <textField isBlankWhenNull="true" textAdjust="ScaleFont">
                    <reportElement style="kpiValue" x="0" y="10" width="74" height="16"/>
                    <textFieldExpression><![CDATA[$P{KPI_VAL_THEO}]]></textFieldExpression>
                </textField>
                <staticText>
