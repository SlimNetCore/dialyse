<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="prise_en_charge" pageWidth="595" pageHeight="842"
              columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="40" bottomMargin="30">

    <parameter name="CENTER_ID" class="java.lang.String"/>
    <parameter name="patientId" class="java.lang.String"/>
    <parameter name="pecId" class="java.lang.String"/>
    <parameter name="SOCIETE_NOM" class="java.lang.String"/>
    <parameter name="SOCIETE_ADRESSE" class="java.lang.String"/>
    <parameter name="SOCIETE_TELEPHONE" class="java.lang.String"/>
    <parameter name="SOCIETE_EMAIL" class="java.lang.String"/>
    <parameter name="SOCIETE_SITE_WEB" class="java.lang.String"/>
    <parameter name="SOCIETE_CONTACT" class="java.lang.String"/>
    <parameter name="SOCIETE_LEGAL" class="java.lang.String"/>
    <parameter name="SOCIETE_PIED_PAGE" class="java.lang.String"/>
    <parameter name="SOCIETE_LOGO" class="java.io.InputStream"/>
    <parameter name="CENTRE_NOM" class="java.lang.String"/>
    <parameter name="CENTRE_ADRESSE" class="java.lang.String"/>
    <parameter name="CENTRE_TELEPHONE" class="java.lang.String"/>
    <parameter name="CENTRE_EMAIL" class="java.lang.String"/>
    <parameter name="CENTRE_SITE_WEB" class="java.lang.String"/>
    <parameter name="CENTRE_CONTACT" class="java.lang.String"/>
    <parameter name="CENTRE_LIGNE" class="java.lang.String"/>

    <queryString>
        <![CDATA[
        SELECT p.nom, p.prenom, p.numero_assurance, p.date_naissance,
               pc.date_debut_demande, pc.date_fin_demande, pc.statut,
               pc.date_debut_effectif, pc.date_fin_effectif,
               c.name AS center_name
        FROM prise_en_charge pc
        JOIN patients p ON p.id = pc.patient_id AND p.center_id = pc.center_id
        JOIN centers c ON c.id = pc.center_id
        WHERE pc.center_id = CAST($P{CENTER_ID} AS UUID)
          AND (
                (NULLIF($P{pecId}, '') IS NOT NULL AND pc.id = CAST($P{pecId} AS UUID))
                OR
                (NULLIF($P{pecId}, '') IS NULL AND NULLIF($P{patientId}, '') IS NOT NULL AND pc.patient_id = CAST($P{patientId} AS UUID))
              )
        ORDER BY pc.date_fin_demande DESC
        LIMIT 1
        ]]>
    </queryString>

    <field name="NOM" class="java.lang.String"/>
    <field name="PRENOM" class="java.lang.String"/>
    <field name="NUMERO_ASSURANCE" class="java.lang.String"/>
    <field name="DATE_NAISSANCE" class="java.sql.Date"/>
    <field name="DATE_DEBUT_DEMANDE" class="java.sql.Date"/>
    <field name="DATE_FIN_DEMANDE" class="java.sql.Date"/>
    <field name="STATUT" class="java.lang.String"/>
    <field name="DATE_DEBUT_EFFECTIF" class="java.sql.Date"/>
    <field name="DATE_FIN_EFFECTIF" class="java.sql.Date"/>
    <field name="CENTER_NAME" class="java.lang.String"/>

    <title>
        <band height="166">
            <image scaleImage="RetainShape" hAlign="Left" vAlign="Top" onErrorType="Blank">
                <reportElement x="0" y="0" width="70" height="56">
                    <printWhenExpression><![CDATA[$P{SOCIETE_LOGO} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{SOCIETE_LOGO}]]></imageExpression>
            </image>
            <textField isBlankWhenNull="true">
                <reportElement x="78" y="0" width="235" height="16"/>
                <textElement textAlignment="Left">
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SOCIETE_NOM}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="78" y="17" width="235" height="26"/>
                <textElement textAlignment="Left">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SOCIETE_CONTACT}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="78" y="44" width="235" height="12"/>
                <textElement textAlignment="Left">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SOCIETE_LEGAL}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="321" y="0" width="214" height="14"/>
                <textElement textAlignment="Right">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CENTRE_NOM}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="321" y="15" width="214" height="14"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CENTRE_ADRESSE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="321" y="30" width="214" height="26"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CENTRE_CONTACT}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="60" width="535" height="1"/>
            </line>
            <textField>
                <reportElement x="0" y="66" width="535" height="28"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{CENTER_NAME}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="101" width="535" height="26"/>
                <textElement textAlignment="Center">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[PRISE EN CHARGE]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="136" width="535" height="1"/>
            </line>
        </band>
    </title>

    <detail>
        <band height="300">
            <!-- Patient info -->
            <staticText>
                <reportElement x="0" y="10" width="535" height="22" backcolor="#E8F5E9" mode="Opaque"/>
                <textElement>
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[  Informations du patient]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="40" width="40" height="18"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Nom :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="45" y="40" width="200" height="18"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{NOM} + " " + $F{PRENOM}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="260" y="40" width="100" height="18"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[N° Assurance :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="365" y="40" width="170" height="18"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{NUMERO_ASSURANCE}]]></textFieldExpression>
            </textField>

            <!-- Demande établissement -->
            <staticText>
                <reportElement x="0" y="80" width="535" height="22" backcolor="#E8F5E9" mode="Opaque"/>
                <textElement>
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[  Demande de l'établissement]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="110" width="80" height="18"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Date début :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="85" y="110" width="180" height="18"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{DATE_DEBUT_DEMANDE}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="270" y="110" width="60" height="18"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Date fin :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="335" y="110" width="200" height="18"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{DATE_FIN_DEMANDE}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="135" width="50" height="18"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Statut :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="55" y="135" width="150" height="18"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{STATUT}]]></textFieldExpression>
            </textField>

            <!-- Accord caisse -->
            <staticText>
                <reportElement x="0" y="170" width="535" height="22" backcolor="#E8F5E9" mode="Opaque"/>
                <textElement>
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[  Accord de la caisse d'assurance]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="200" width="110" height="18"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Date début eff. :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="115" y="200" width="150" height="18"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{DATE_DEBUT_EFFECTIF}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="270" y="200" width="90" height="18"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Date fin eff. :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="365" y="200" width="170" height="18"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{DATE_FIN_EFFECTIF}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="58">
            <textField>
                <reportElement x="0" y="5" width="250" height="16"/>
                <textElement>
                    <font size="7" isItalic="true"/>
                </textElement>
                <textFieldExpression>
                    <![CDATA["Imprimé le " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="30" width="535" height="1"/>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="33" width="535" height="11"/>
                <textElement textAlignment="Center">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CENTRE_LIGNE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="44" width="535" height="11"/>
                <textElement textAlignment="Center">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SOCIETE_PIED_PAGE}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>

