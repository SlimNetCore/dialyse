                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SOCIETE_CONTACT}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="78" y="44" width="396" height="12"/>
                <textElement textAlignment="Left">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SOCIETE_LEGAL}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="482" y="0" width="320" height="14"/>
                <textElement textAlignment="Right">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CENTRE_NOM}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="482" y="15" width="320" height="14"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CENTRE_ADRESSE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="482" y="30" width="320" height="26"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CENTRE_CONTACT}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="60" width="802" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="68" width="802" height="22"/>
                <textElement textAlignment="Center">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[PLANNING DE PRÉSENCE DES INFIRMIERS]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="90" width="802" height="14"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SEMAINE_LABEL}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <columnHeader>
