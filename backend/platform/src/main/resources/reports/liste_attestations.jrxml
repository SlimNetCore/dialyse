                </textElement>
                <textFieldExpression><![CDATA[$P{CENTRE_LIGNE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="14" width="802" height="11"/>
                <textElement textAlignment="Center">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SOCIETE_PIED_PAGE}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>

