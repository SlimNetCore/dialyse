<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="liste_attestations" pageWidth="842" pageHeight="595" orientation="Landscape"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" columnWidth="802">
    <parameter name="CENTER_ID" class="java.lang.String"/>
    <parameter name="SOCIETE_NOM" class="java.lang.String"/>
    <parameter name="SOCIETE_ADRESSE" class="java.lang.String"/>
    <parameter name="SOCIETE_TELEPHONE" class="java.lang.String"/>
    <parameter name="SOCIETE_EMAIL" class="java.lang.String"/>
    <parameter name="SOCIETE_SITE_WEB" class="java.lang.String"/>
    <parameter name="SOCIETE_CONTACT" class="java.lang.String"/>
    <parameter name="SOCIETE_LEGAL" class="java.lang.String"/>
    <parameter name="SOCIETE_PIED_PAGE" class="java.lang.String"/>
    <parameter name="SOCIETE_LOGO" class="java.io.InputStream"/>
    <parameter name="CENTRE_NOM" class="java.lang.String"/>
    <parameter name="CENTRE_ADRESSE" class="java.lang.String"/>
    <parameter name="CENTRE_TELEPHONE" class="java.lang.String"/>
    <parameter name="CENTRE_EMAIL" class="java.lang.String"/>
    <parameter name="CENTRE_SITE_WEB" class="java.lang.String"/>
    <parameter name="CENTRE_CONTACT" class="java.lang.String"/>
    <parameter name="CENTRE_LIGNE" class="java.lang.String"/>
    <queryString><![CDATA[
      SELECT a.id, p.code_patient, p.nom, p.prenom, p.numero_assurance,
             a.date_debut, a.date_fin
      FROM attestation_droit a
      JOIN patients p ON p.id = a.patient_id AND p.center_id = a.center_id
      WHERE a.center_id = CAST($P{CENTER_ID} AS UUID)
      ORDER BY a.date_fin DESC
    ]]></queryString>

    <field name="CODE_PATIENT" class="java.lang.String"/>
    <field name="NOM" class="java.lang.String"/>
    <field name="PRENOM" class="java.lang.String"/>
    <field name="NUMERO_ASSURANCE" class="java.lang.String"/>
    <field name="DATE_DEBUT" class="java.sql.Date"/>
    <field name="DATE_FIN" class="java.sql.Date"/>

    <title>
        <band height="106">
            <image scaleImage="RetainShape" hAlign="Left" vAlign="Top" onErrorType="Blank">
                <reportElement x="0" y="0" width="70" height="56">
                    <printWhenExpression><![CDATA[$P{SOCIETE_LOGO} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{SOCIETE_LOGO}]]></imageExpression>
            </image>
            <textField isBlankWhenNull="true">
                <reportElement x="78" y="0" width="396" height="16"/>
                <textElement textAlignment="Left">
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SOCIETE_NOM}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="78" y="17" width="396" height="26"/>
                <textElement textAlignment="Left">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SOCIETE_CONTACT}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="78" y="44" width="396" height="12"/>
                <textElement textAlignment="Left">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{SOCIETE_LEGAL}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="482" y="0" width="320" height="14"/>
                <textElement textAlignment="Right">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CENTRE_NOM}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="482" y="15" width="320" height="14"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CENTRE_ADRESSE}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="482" y="30" width="320" height="26"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CENTRE_CONTACT}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="60" width="802" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="74" width="802" height="24"/>
                <textElement textAlignment="Center">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[LISTE DES OUVERTURES DE DROIT]]></text>
            </staticText>
        </band>
    </title>
    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="100" height="18" backcolor="#1B5E20" mode="Opaque"
                               forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Code]]></text>
            </staticText>
            <staticText>
                <reportElement x="100" y="0" width="140" height="18" backcolor="#1B5E20" mode="Opaque"
                               forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Nom]]></text>
            </staticText>
            <staticText>
                <reportElement x="240" y="0" width="140" height="18" backcolor="#1B5E20" mode="Opaque"
                               forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Prénom]]></text>
            </staticText>
            <staticText>
                <reportElement x="380" y="0" width="170" height="18" backcolor="#1B5E20" mode="Opaque"
                               forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[N° Assurance]]></text>
            </staticText>
            <staticText>
                <reportElement x="550" y="0" width="126" height="18" backcolor="#1B5E20" mode="Opaque"
                               forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Date début]]></text>
            </staticText>
            <staticText>
                <reportElement x="676" y="0" width="126" height="18" backcolor="#1B5E20" mode="Opaque"
                               forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Date fin]]></text>
            </staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="16">
            <textField>
                <reportElement x="0" y="0" width="100" height="14"/>
                <textElement textAlignment="Center">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{CODE_PATIENT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="100" y="0" width="140" height="14"/>
                <textElement>
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{NOM}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="240" y="0" width="140" height="14"/>
                <textElement>
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{PRENOM}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="380" y="0" width="170" height="14"/>
                <textElement textAlignment="Center">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{NUMERO_ASSURANCE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="550" y="0" width="126" height="14"/>
                <textElement textAlignment="Center">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{DATE_DEBUT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="676" y="0" width="126" height="14"/>
                <textElement textAlignment="Center">
                    <font size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{DATE_FIN}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="28">
            <line>
                <reportElement x="0" y="0" width="802" height="1"/>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="3" width="802" height="11"/>
                <textElement textAlignment="Center">
