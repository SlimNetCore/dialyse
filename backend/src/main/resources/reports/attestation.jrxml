<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="attestation" pageWidth="595" pageHeight="842"
              columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="40" bottomMargin="30">

    <parameter name="CENTER_ID" class="java.lang.String"/>
    <parameter name="patientId" class="java.lang.String"/>
    <parameter name="attestationId" class="java.lang.String"/>

    <queryString>
        <![CDATA[
        SELECT p.nom, p.prenom, p.sexe, p.date_naissance, p.numero_assurance,
               p.adresse, p.tel_mobile,
               a.date_debut, a.date_fin,
               c.name AS center_name
        FROM attestation_droit a
        JOIN patients p ON p.id = a.patient_id AND p.center_id = a.center_id
        JOIN centers c ON c.id = a.center_id
        WHERE a.center_id = CAST($P{CENTER_ID} AS UUID)
          AND (
                (NULLIF($P{attestationId}, '') IS NOT NULL AND a.id = CAST($P{attestationId} AS UUID))
                OR
                (NULLIF($P{attestationId}, '') IS NULL AND NULLIF($P{patientId}, '') IS NOT NULL AND a.patient_id = CAST($P{patientId} AS UUID))
              )
        ORDER BY a.date_fin DESC
        LIMIT 1
        ]]>
    </queryString>

    <field name="NOM" class="java.lang.String"/>
    <field name="PRENOM" class="java.lang.String"/>
    <field name="SEXE" class="java.lang.String"/>
    <field name="DATE_NAISSANCE" class="java.sql.Date"/>
    <field name="NUMERO_ASSURANCE" class="java.lang.String"/>
    <field name="ADRESSE" class="java.lang.String"/>
    <field name="TEL_MOBILE" class="java.lang.String"/>
    <field name="DATE_DEBUT" class="java.sql.Date"/>
    <field name="DATE_FIN" class="java.sql.Date"/>
    <field name="CENTER_NAME" class="java.lang.String"/>

    <title>
        <band height="100">
            <textField>
                <reportElement x="0" y="0" width="535" height="30"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{CENTER_NAME}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="40" width="535" height="26"/>
                <textElement textAlignment="Center">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[ATTESTATION D'OUVERTURE DE DROIT]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="75" width="535" height="1"/>
            </line>
        </band>
    </title>

    <detail>
        <band height="250">
            <staticText>
                <reportElement x="0" y="20" width="130" height="20"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[N° Sécurité sociale :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="135" y="20" width="300" height="20"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{NUMERO_ASSURANCE}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="50" width="50" height="20"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Nom :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="55" y="50" width="200" height="20"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{NOM}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="260" y="50" width="60" height="20"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Prénom :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="325" y="50" width="210" height="20"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{PRENOM}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="80" width="100" height="20"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Date naissance :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="105" y="80" width="200" height="20"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{DATE_NAISSANCE}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="130" width="535" height="22" backcolor="#E8F5E9" mode="Opaque"/>
                <textElement>
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[  Période de validité]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="160" width="80" height="20"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Date début :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="85" y="160" width="180" height="20"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{DATE_DEBUT}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="270" y="160" width="60" height="20"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Date fin :]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="335" y="160" width="200" height="20"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{DATE_FIN}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="0" y="5" width="250" height="16"/>
                <textElement>
                    <font size="7" isItalic="true"/>
                </textElement>
                <textFieldExpression>
                    <![CDATA["Imprimé le " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>

